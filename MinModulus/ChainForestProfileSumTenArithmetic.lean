/-- Every compatible primitive phase of an unequal sum-ten pair has
one checked certificate, with a common starting length of 67. -/
theorem exists_sum_ten_unequal_basis_certificate
    {a b e r q : ℕ} {P Q : ℤ}
    (hpairs : (a=2 ∧ b=8) ∨ (a=3 ∧ b=7) ∨ (a=4 ∧ b=6))
    (he : 1 ≤ e ∧ e < a)
    (hr : (P=(2^(b-1) : ℕ)-1 ∧ Q=3-(2^(b-a) : ℕ) ∧
        r < (unequalPrimitiveBasisGeometry a b e).F*(unequalPrimitiveBasisGeometry a b e).T ∧
        1 ≤ q ∧ q ≤ (unequalPrimitiveBasisGeometry a b e).T) ∨
      (P= -((3*2^(b-1) : ℕ)-1) ∧ Q=(3*2^(b-a) : ℕ)-1 ∧
        1 ≤ r ∧ r ≤ (unequalPrimitiveBasisGeometry a b e).F*(unequalPrimitiveBasisGeometry a b e).T ∧
        q < (unequalPrimitiveBasisGeometry a b e).T))
    (hlink : (unequalPrimitiveBasisGeometry a b e).T ∣ 4*r+q) :
    ∃ p, SumTenUnequalBasisCertificate (unequalPrimitiveBasisGeometry a b e) P Q r q p := by
  rcases he with ⟨helo,hehi⟩
  rcases hpairs with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · interval_cases e
    · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
      · have hqeq := positive_primitive_phase_eq_of_link (by decide : 0 < 447) hqlo hqhi hlink
        subst q
        exact ⟨_,sumTenBasis28_1_0_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hr; omega⟩ hr⟩
      · have hqeq := bounded_primitive_phase_eq_of_link (by decide : 0 < 447) hq hlink
        subst q
        exact ⟨_,sumTenBasis28_1_1_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hrhi; omega⟩ (by change 0 < r; omega)⟩
  · interval_cases e
    · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
      · have hqeq := positive_primitive_phase_eq_of_link (by decide : 0 < 239) hqlo hqhi hlink
        subst q
        exact ⟨_,sumTenBasis37_1_0_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hr; omega⟩ hr⟩
      · have hqeq := bounded_primitive_phase_eq_of_link (by decide : 0 < 239) hq hlink
        subst q
        exact ⟨_,sumTenBasis37_1_1_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hrhi; omega⟩ (by change 0 < r; omega)⟩
    · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
      · have hqeq := positive_primitive_phase_eq_of_link (by decide : 0 < 239) hqlo hqhi hlink
        subst q
        exact ⟨_,sumTenBasis37_2_0_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hr; omega⟩ hr⟩
      · have hqeq := bounded_primitive_phase_eq_of_link (by decide : 0 < 239) hq hlink
        subst q
        exact ⟨_,sumTenBasis37_2_1_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hrhi; omega⟩ (by change 0 < r; omega)⟩
  · interval_cases e
    · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
      · have hqeq := positive_primitive_phase_eq_of_link (by decide : 0 < 123) hqlo hqhi hlink
        subst q
        exact ⟨_,sumTenBasis46_1_0_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hr; omega⟩ hr⟩
      · have hqeq := bounded_primitive_phase_eq_of_link (by decide : 0 < 123) hq hlink
        subst q
        exact ⟨_,sumTenBasis46_1_1_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hrhi; omega⟩ (by change 0 < r; omega)⟩
    · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
      · have hqeq := positive_primitive_phase_eq_of_link (by decide : 0 < 123) hqlo hqhi hlink
        subst q
        exact ⟨_,sumTenBasis46_2_0_checked ⟨r,by norm_num [unequalPrimitiveBasisGeometry] at hr; omega⟩ hr⟩
