/-- The complete tables and uniform certificate consumers produce an
actual affordable group rival for every unequal sum-ten primitive phase. -/
theorem exists_sum_ten_unequal_primitive_rival
    {a b e n N L M E H c V α z r q : ℕ} {P Q : ℤ}
    (hpairs : (a=2 ∧ b=8) ∨ (a=3 ∧ b=7) ∨ (a=4 ∧ b=6))
    (he : 1 ≤ e ∧ e < a) (hn : 67 ≤ n) (hL : L+a+b=n)
    (hr : (P=(2^(b-1) : ℕ)-1 ∧ Q=3-(2^(b-a) : ℕ) ∧
        r < (unequalPrimitiveBasisGeometry a b e).F*(unequalPrimitiveBasisGeometry a b e).T ∧
        1 ≤ q ∧ q ≤ (unequalPrimitiveBasisGeometry a b e).T) ∨
      (P= -((3*2^(b-1) : ℕ)-1) ∧ Q=(3*2^(b-a) : ℕ)-1 ∧
        1 ≤ r ∧ r ≤ (unequalPrimitiveBasisGeometry a b e).F*(unequalPrimitiveBasisGeometry a b e).T ∧
        q < (unequalPrimitiveBasisGeometry a b e).T))
    (hlink : (unequalPrimitiveBasisGeometry a b e).T ∣ 4*r+q)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(unequalPrimitiveBasisGeometry a b e).w*2^L)
    (hE : E ≤ (unequalPrimitiveBasisGeometry a b e).W*H)
    (hap : ((unequalPrimitiveBasisGeometry a b e).F*(unequalPrimitiveBasisGeometry a b e).T : ℕ)*(α : ℤ)=
      P*((2 : ℤ)^L-H)+((unequalPrimitiveBasisGeometry a b e).t : ℤ)*c+(r : ℤ)*M)
    (hzp : ((unequalPrimitiveBasisGeometry a b e).T : ℤ)*z=Q*(2 : ℤ)^L+
      ((unequalPrimitiveBasisGeometry a b e).T-Q)*H+
      ((unequalPrimitiveBasisGeometry a b e).T-(unequalPrimitiveBasisGeometry a b e).v)*c-
      (unequalPrimitiveBasisGeometry a b e).T+(q : ℤ)*M)
    (x xa xb : ZMod N) (hα : α • x=(unequalPrimitiveBasisGeometry a b e).D • xa)
    (hz : z • x+xa+xb=V • x) (hmx : M • x=0) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 2^a-1 ∨ tb ≠ 2^b-1) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin (a-1) ta+gmin (b-1) tb ≤ n ∧
      s • x+ta • xa+tb • xb=V • x := by
  obtain ⟨p,hp⟩ := exists_sum_ten_unequal_basis_certificate hpairs he hr hlink
  rcases hp with hp | hp
  · obtain ⟨s,hs,hne,u,hu,hcost,heval⟩ := exists_rival_of_primitive_basis_nonintegral_certificate
      (unequalPrimitiveBasisGeometry a b e) p hn hL hH hnc hbase hM hE hap hzp x xa xb hα hz hmx hp
    exact ⟨s,p.ta,p.tb,hs,hne,u,hu,hcost,heval⟩
  · obtain ⟨s,hs,hne,u,hu,hcost,heval⟩ := exists_rival_of_primitive_basis_integral_certificate
      (unequalPrimitiveBasisGeometry a b e) p hn hL hH hc hnc hbase hM hE hap hzp x xa xb hα hz hmx hp
    exact ⟨s,p.ta,p.tb,hs,hne,u,hu,hcost,heval⟩

end MinModulus
