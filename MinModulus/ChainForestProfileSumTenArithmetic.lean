/-! Complete signed-basis certificates for the unequal sum-ten companion
pairs (2,8), (3,7), and (4,6). All 4050 phases, including 22 integral phases,
are checked by kernel reduction. The shared consumers give affordable
actual group rivals at every n >= 67. The genuine-forest consumer is separate.
The unrestricted conjecture remains open. -/

namespace MinModulus

def unequalPrimitiveBasisGeometry (a b e : ℕ) : PrimitiveBasisGeometry :=
  ⟨a,b,2^e,2^(a-1-e),4*2^(b-1)-2^(b-a)-1,
    4*2^(a-1-e)*2^(b-1),2^(a-1-e)*2^(b-1),2^(b-1),2^(b-a)+1⟩

def SumTenUnequalBasisCertificate (g : PrimitiveBasisGeometry)
    (P Q r q : ℤ) (p : PrimitiveBasisRivalPlan) : Prop :=
  PrimitiveBasisNonintegralCertificate g 32 10000 67 P Q r q p ∨
  PrimitiveBasisIntegralCertificate g 40 2000 67 P Q r q p

instance (g : PrimitiveBasisGeometry) (P Q r q : ℤ) (p : PrimitiveBasisRivalPlan) :
    Decidable (SumTenUnequalBasisCertificate g P Q r q p) := by
  unfold SumTenUnequalBasisCertificate
  infer_instance

