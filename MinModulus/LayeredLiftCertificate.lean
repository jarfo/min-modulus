import MinModulus.StratumOneCancel

/-!
# Layered lift certificates

A finite exclusion at modulus `N` need not search `N` residues per coordinate.
Writing `N = K * M`, every tuple modulo `N` lies over a *quotient* modulo `M`,
and the lift is a vector of kernel coefficients.  A rival of the quotient lifts
to a rival of the tuple exactly when one congruence modulo `K` holds, so a
family of quotient rivals whose congruences **cover** every lift pattern
excludes every lift at once.

* `kernel_mul_cast` — the kernel of `ZMod (K*M) → ZMod M` is generated by `M`.
* `not_exists_valid_lift_of_covering` — the covering certificate.
* `not_exists_valid_of_quotient_cover` — the interface that lets a search run
  over quotients modulo `M` instead of residues modulo `N`.
* `quotient_card_le_two` — at `K = 2` a valid tuple meets each quotient value at
  most twice, which is what keeps the quotient search small.

At `K = 2` the covering condition degenerates: "avoid one of two values" is an
affine equation over `𝔽₂`, so the certificate is a linear dependency of at most
`n` rows (`SmallLiftCertificate.no_valid_cyclic_lift_iff_small_carry_obstruction`).
For `K > 2` it does not: avoiding one of `K` values is not an equation, so the
certificate is a genuine covering family and no `≤ n` bound is available.

## What this costs and buys, measured

Against the existing `ClosedPrefix` scheme (a DFS over increasing residues
modulo `N`, one packed rival per leaf), with the same unit normalisation:

* `K = 2` (valuation-one moduli): 3.0–4.4× fewer tree nodes, but each leaf needs
  up to five rows instead of one packed rival, so the **payload is a wash**
  (0.89–1.34×).  Measured at `N = 34, 38, 46, 58` (`n = 6`) and `N = 66`
  (`n = 7`).
* `K` the whole two-adic part: the tree collapses (`N = 56`: 60,107 nodes →
  196; `N = 120`: 2.2M leaves → 11,628 quotient nodes) and the stored rows drop
  2.3–16×.

The catch is verification.  A covering family cannot be checked in `O(K)`: one
might hope for a family sharing a single linear form and differing only in
carry, which covers by inspection, but the form *is* the rival — `c = k - 1`
determines `k`, hence the carry — so each form carries exactly one value and
such families do not exist (checked: 0 of 8568 leaves at `N = 120`).  Verifying
a cover therefore enumerates `K ^ L` lift patterns per leaf, which is the same
work the classical scheme already does one tuple at a time.  So the layered
certificate is smaller to *store* and no cheaper to *check*; it is not a
replacement for the existing finite exclusions.
-/

namespace MinModulus

open Finset

/-- The kernel of `ZMod (K*M) → ZMod M` is generated by `M`. -/
theorem kernel_mul_cast {K M : ℕ} (hK : 0 < K) (hM : 0 < M) (x : ZMod (K * M))
    (hx : ZMod.castHom (dvd_mul_left M K) (ZMod M) x = 0) :
    ∃ a : ℕ, x = a • ((M : ℕ) : ZMod (K * M)) := by
  haveI : NeZero (K * M) := ⟨Nat.mul_ne_zero (by omega) (by omega)⟩
  haveI : NeZero M := ⟨by omega⟩
  have hval : ((x.val : ℕ) : ZMod (K * M)) = x := ZMod.natCast_rightInverse x
  have hred : ZMod.castHom (dvd_mul_left M K) (ZMod M) ((x.val : ℕ) : ZMod (K * M))
      = ((x.val : ℕ) : ZMod M) := map_natCast _ _
  rw [hval, hx] at hred
  obtain ⟨a, ha⟩ : M ∣ x.val := (ZMod.natCast_eq_zero_iff _ _).mp hred.symm
  refine ⟨a, ?_⟩
  rw [← hval, ha, nsmul_eq_mul]
  push_cast
  ring

/-- **Layered lift exclusion.**  Let `N = K * M` and let `v` be any lift of the
quotient `q`.  Suppose a finite family `S` of quotient rivals carries kernel
coefficients `b`, and that for every lift pattern `a` some member satisfies
`K ∣ b c + ∑ cᵢ aᵢ`.  Then no lift of `q` is a valid tuple. -/
theorem not_exists_valid_lift_of_covering
    {n K M : ℕ} (hK : 0 < K) (hM : 0 < M)
    (q : Fin n → ZMod M) (v : Fin n → ZMod (K * M))
    (hv : ∀ i, ZMod.castHom (dvd_mul_left M K) (ZMod M) (v i) = q i)
    (S : Finset (Fin n → ℤ)) (b : (Fin n → ℤ) → ℤ)
    (hS : ∀ c ∈ S, Witness q 0 c)
    (hb : ∀ c ∈ S, (∑ i, c i • v i) = (b c) • ((M : ℕ) : ZMod (K * M)))
    (hcover : ∀ a : Fin n → ℤ, ∃ c ∈ S, (K : ℤ) ∣ (b c + ∑ i, c i * a i)) :
    ¬ ∃ g : Fin n → ZMod (K * M), ValidTuple g ∧
        ∀ i, ZMod.castHom (dvd_mul_left M K) (ZMod M) (g i) = q i := by
  classical
  rintro ⟨g, hgv, hgq⟩
  have hdiff : ∀ i, ∃ a : ℕ, g i - v i = a • ((M : ℕ) : ZMod (K * M)) := by
    intro i
    refine kernel_mul_cast hK hM _ ?_
    rw [map_sub, hgq i, hv i, sub_self]
  choose a ha using hdiff
  have hgi : ∀ i, g i = v i + (a i : ℤ) • ((M : ℕ) : ZMod (K * M)) := by
    intro i
    have h := ha i
    rw [natCast_zsmul]
    rw [← h]
    ring
  obtain ⟨c, hcS, m, hm⟩ := hcover (fun i => (a i : ℤ))
  obtain ⟨hne, hge, hsum, -⟩ := hS c hcS
  refine (validTuple_iff_no_zero_witness g).mp hgv c ⟨hne, hge, hsum, ?_⟩
  have hterm : ∀ i, c i • g i
      = c i • v i + (c i * (a i : ℤ)) • ((M : ℕ) : ZMod (K * M)) := by
    intro i
    rw [hgi i, smul_add, mul_smul]
  have hKM : ((K : ℤ)) • ((M : ℕ) : ZMod (K * M)) = 0 := by
    rw [zsmul_eq_mul]
    push_cast
    rw [← Nat.cast_mul, ZMod.natCast_self]
  calc ∑ i, c i • g i
      = (∑ i, c i • v i) + (∑ i, c i * (a i : ℤ)) • ((M : ℕ) : ZMod (K * M)) := by
        rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_add_distrib,
          Finset.sum_smul]
    _ = (b c + ∑ i, c i * (a i : ℤ)) • ((M : ℕ) : ZMod (K * M)) := by
        rw [hb c hcS, ← add_smul]
    _ = ((K : ℤ) * m) • ((M : ℕ) : ZMod (K * M)) := by rw [hm]
    _ = (m * (K : ℤ)) • ((M : ℕ) : ZMod (K * M)) := by rw [mul_comm (K : ℤ) m]
    _ = m • ((K : ℤ) • ((M : ℕ) : ZMod (K * M))) := mul_smul _ _ _
    _ = 0 := by rw [hKM, smul_zero]

/-- A search over quotients modulo `M` suffices to exclude every tuple modulo
`K * M`. -/
theorem not_exists_valid_of_quotient_cover {n K M : ℕ}
    (hall : ∀ q : Fin n → ZMod M, ¬ ∃ g : Fin n → ZMod (K * M), ValidTuple g ∧
      ∀ i, ZMod.castHom (dvd_mul_left M K) (ZMod M) (g i) = q i) :
    ¬ ∃ g : Fin n → ZMod (K * M), ValidTuple g := by
  rintro ⟨g, hg⟩
  exact hall (fun i => ZMod.castHom (dvd_mul_left M K) (ZMod M) (g i)) ⟨g, hg, fun _ => rfl⟩

/-- At `K = 2` a valid tuple meets every quotient value at most twice: three
coordinates in one fibre would make the sheet add to itself and survive. -/
theorem quotient_card_le_two {n M : ℕ} (hM : 1 ≤ M) {g : Fin n → ZMod (2 * M)}
    (hg : ValidTuple g) (y : ZMod M) :
    (Finset.univ.filter
      (fun i => ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g i) = y)).card ≤ 2 := by
  classical
  by_contra hcon
  have h3 : 2 < (Finset.univ.filter
      (fun i => ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g i) = y)).card := by omega
  obtain ⟨i, j, k, hi, hj, hk, hij, hik, hjk⟩ := Finset.two_lt_card_iff.mp h3
  have hmem : ∀ {p : Fin n}, p ∈ Finset.univ.filter
      (fun i => ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g i) = y) →
      ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g p) = y := by
    intro p hp; simpa using (Finset.mem_filter.mp hp).2
  have hsheet : ∀ {p r : Fin n}, p ≠ r →
      ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g p) = y →
      ZMod.castHom (dvd_mul_left M 2) (ZMod M) (g r) = y →
      g p - g r = ((M : ℕ) : ZMod (2 * M)) := by
    intro p r hpr hp hr
    rcases StratumOne.kernel_two_mul hM (g p - g r) (by rw [map_sub, hp, hr, sub_self]) with h | h
    · exact absurd (validTuple_injective g hg (sub_eq_zero.mp h)) hpr
    · exact h
  have h1 := hsheet hij (hmem hi) (hmem hj)
  have h2 := hsheet hjk (hmem hj) (hmem hk)
  have h3 := hsheet hik (hmem hi) (hmem hk)
  have hadd : g i - g k = ((M : ℕ) : ZMod (2 * M)) + ((M : ℕ) : ZMod (2 * M)) := by
    have hsplit : g i - g k = (g i - g j) + (g j - g k) := by ring
    rw [hsplit, h1, h2]
  rw [h3, StratumOne.sheet_add_self] at hadd
  exact StratumOne.sheet_ne_zero hM hadd

end MinModulus
