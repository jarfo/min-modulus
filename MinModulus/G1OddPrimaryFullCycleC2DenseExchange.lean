import MinModulus.G1OddPrimaryFullCycleC2PivotAlignment
import MinModulus.G1OddPrimaryFullCyclePositiveStratumExchange

namespace MinModulus

open Finset

variable {n : ℕ} {G : Type*} [AddCommGroup G]

/-- An exact signed pair whose target is a multiple of `y` has its oriented
endpoint difference in the cyclic subgroup generated by `y`. -/
theorem ExactSignedPairWitness.left_sub_right_mem_zmultiples
    (g : Fin n → G) (y : G) {scalar : ℤ} {c : Fin n → ℤ}
    {u v : Fin n}
    (hpair : ExactSignedPairWitness g (scalar • y) c u v) :
    g u - g v ∈ AddSubgroup.zmultiples y := by
  rcases hpair.2.1 with hforward | hreverse
  · rw [← hforward.2.2]
    exact AddSubgroup.zsmul_mem _ (AddSubgroup.mem_zmultiples y) scalar
  · have hmem : g v - g u ∈ AddSubgroup.zmultiples y := by
      rw [← hreverse.2.2]
      exact AddSubgroup.zsmul_mem _ (AddSubgroup.mem_zmultiples y) scalar
    have hneg := (AddSubgroup.zmultiples y).neg_mem hmem
    convert hneg using 1
    abel

/-- Minimize a literal exact-two transversal exchange using only the nonzero
quotient difference needed for transversality.  A strict shrink retains at
least three coordinates; otherwise the literal exchanged set is itself the
new minimal exact-two transversal. -/
theorem exists_minimalCyclicKernelTransversal_exchange_of_pairDifference_not_mem_or_three
    (g : Fin n → G) (y : G) {B : Finset (Fin n)}
    (hmin : MinimalCyclicKernelSupportTransversal g y B)
    (hretained : n - B.card = 2)
    {b x z : Fin n} (hb : b ∈ B) (hxB : x ∉ B) (hzB : z ∉ B)
    (hxz : x ≠ z) (hcomplement : Finset.univ \ B = {x, z})
    (hdiff : g b - g z ∉ AddSubgroup.zmultiples y) :
    (∃ B₀ : Finset (Fin n),
        MinimalCyclicKernelSupportTransversal g y B₀ ∧
          3 ≤ n - B₀.card) ∨
      (MinimalCyclicKernelSupportTransversal g y
          (insert x (B.erase b)) ∧
        n - (insert x (B.erase b)).card = 2) := by
  classical
  let Bexchange : Finset (Fin n) := insert x (B.erase b)
  have hBexchange : CyclicKernelSupportTransversal g y Bexchange := by
    simpa only [Bexchange] using
      cyclicKernelSupportTransversal_exchange_of_pairDifference_not_mem
        g y hmin.1 hb hxB hzB hxz hcomplement hdiff
  obtain ⟨B₀, hB₀sub, hB₀min⟩ :=
    exists_minimalCyclicKernelSupportTransversal_subset g y hBexchange
  have hBexchangeCard : Bexchange.card = B.card := by
    simpa only [Bexchange] using card_erase_insert_retained_eq hb hxB
  have hB₀card : B₀.card ≤ B.card := by
    calc
      B₀.card ≤ Bexchange.card := Finset.card_le_card hB₀sub
      _ = B.card := hBexchangeCard
  by_cases hstrict : B₀.card < B.card
  · left
    refine ⟨B₀, hB₀min, ?_⟩
    have hBcard : B.card ≤ n := by
      simpa using Finset.card_le_univ B
    omega
  · right
    have hcardEq : B₀.card = B.card := by omega
    have hB₀eq : B₀ = Bexchange := by
      apply Finset.eq_of_subset_of_card_le hB₀sub
      rw [hBexchangeCard, hcardEq]
    subst B₀
    refine ⟨hB₀min, ?_⟩
    rw [hBexchangeCard]
    exact hretained

/-- Moving the unique retained cycle leaf into the transversal and deleting
another cycle leaf moves the unique retained index to that deleted leaf. -/
theorem cycleLeaf_mem_insert_erase_uniqueRetained_iff
    {d : ℕ} (B : Finset (Fin n)) (leaf : Fin d → Fin n)
    (hleafInj : Function.Injective leaf) {p j : Fin d}
    (hleafB : ∀ i, leaf i ∈ B ↔ i ≠ p) (hjp : j ≠ p) :
    ∀ i, leaf i ∈ insert (leaf p) (B.erase (leaf j)) ↔ i ≠ j := by
  classical
  intro i
  constructor
  · intro hi hij
    subst i
    simp only [Finset.mem_insert, Finset.mem_erase] at hi
    rcases hi with hjpEq | ⟨hjj, _⟩
    · exact hjp (hleafInj hjpEq)
    · exact hjj rfl
  · intro hij
    by_cases hip : i = p
    · subst i
      exact Finset.mem_insert_self _ _
    · apply Finset.mem_insert_of_mem
      exact Finset.mem_erase.mpr
        ⟨fun hleaf ↦ hij (hleafInj hleaf), (hleafB i).2 hip⟩

/-- Family-level currency extracted from the pivot-aligned dense arm.  Every
selected internal owner admits the literal pivot-for-owner exchange.  After
minimization, that exchange either retains at least three coordinates or is
an exact-two state whose unique retained cycle leaf has moved to the owner. -/
def TwoRetainedPivotAlignedDenseExchangeFamily
    {t q : ℕ} (g : Fin n → ZMod (2 ^ t * q))
    (y : ZMod (2 ^ t * q)) (B : Finset (Fin n))
    {d : ℕ} (leaf : Fin d → Fin n) (J : Finset (Fin d)) : Prop :=
  ∃ scalar : ↥J → ℤ, ∃ coeff : ↥J → Fin n → ℤ,
    ∃ I : Finset ↥J, ∃ p : Fin d, ∃ x : Fin n,
      d - 1 ≤ 2 * I.card ∧ I.Nonempty ∧
      (∀ i, leaf i ∈ B ↔ i ≠ p) ∧
      x ∉ B ∧ x ∉ Finset.univ.image leaf ∧
      Finset.univ \ B = {leaf p, x} ∧
      (let H := AddSubgroup.zmultiples y
       let pi : ZMod (2 ^ t * q) →+ ZMod (2 ^ t * q) ⧸ H :=
         QuotientAddGroup.mk' H
       addOrderOf (pi (g (leaf p) - g x)) = 2 ^ (t - 1) ∨
         addOrderOf (pi (g (leaf p) - g x)) = 2 ^ t) ∧
      ∀ j : ↥I,
        scalar (j : ↥J) • y ≠ 0 ∧
        ExactSignedPairWitness g (scalar (j : ↥J) • y)
          (coeff (j : ↥J)) (leaf (j : Fin d)) (leaf p) ∧
        g (leaf (j : Fin d)) - g (leaf p) ∈
          AddSubgroup.zmultiples y ∧
        ((∃ B₀ : Finset (Fin n),
            MinimalCyclicKernelSupportTransversal g y B₀ ∧
              3 ≤ n - B₀.card) ∨
          (MinimalCyclicKernelSupportTransversal g y
              (insert (leaf p) (B.erase (leaf (j : Fin d)))) ∧
            n - (insert (leaf p) (B.erase (leaf (j : Fin d)))).card = 2 ∧
            ∀ i, leaf i ∈
                insert (leaf p) (B.erase (leaf (j : Fin d))) ↔
              i ≠ (j : Fin d)))

/-- The unchanged sparse external arm of the dominant component frontier. -/
def TwoRetainedDominantExternalCycleComponentArm
    (g : Fin n → G) (y base : G) (B : Finset (Fin n))
    {d : ℕ} (center : Fin d → Fin n) (P : Equiv.Perm (Fin d))
    (J : Finset (Fin d)) (R : Equiv.Perm (Fin d))
    (componentThreshold : ℕ) : Prop :=
  ∃ scalar : ↥J → ℤ, ∃ coeff : ↥J → Fin n → ℤ,
    ∃ E I : Finset ↥J, ∃ supportCoord : ↥E → Fin n,
      E ∪ I = Finset.univ ∧ Disjoint E I ∧
      E.card + I.card = J.card ∧ d - 1 ≤ E.card + I.card ∧
      (∀ j, scalar j • y ≠ 0 ∧
        Witness g (scalar j • y) (coeff j)) ∧
      (∀ e : ↥E,
        supportCoord e ∉ Finset.univ.image center ∧
        supportCoord e ∉ B ∧
        coeff (e : ↥J) (supportCoord e) ≠ 0) ∧
      2 * I.card < d - 1 ∧
      ∃ label ∈ (((Finset.univ \ B) \
            (Finset.univ.image center : Finset (Fin n))).product
          twoRetainedExternalCoefficientLevels),
        let F : Finset ↥E := Finset.univ.filter (fun e : ↥E ↦
          (supportCoord e,
            coeff (e : ↥J) (supportCoord e)) = label)
        F.Nonempty ∧ E.card ≤ 6 * F.card ∧
          FixedExternalCoefficientPrivateFiber
            B center P coeff F label.1 label.2 ∧
          FixedExternalTwoRetainedDominantRelativeAffineCycleComponentFrontier
            g y base B center P R scalar coeff I F label.1 label.2
              componentThreshold

/-- At every nontrivial positive stratum, the pivot-aligned exact-two
frontier refines losslessly to either a family of literal dense exchanges or
the pre-existing sparse external component arm. -/
theorem twoRetainedPivotAligned_positiveStratum_denseExchangeFamily_or_external
    {m t q : ℕ} [NeZero (2 ^ t * q)] (ht : 2 ≤ t)
    (g : Fin (m + 1) → ZMod (2 ^ t * q)) (hg : ValidTuple g)
    {h : ZMod (2 ^ t * q)}
    (hunique : ∀ u : ZMod (2 ^ t * q),
      u + u = 0 → u = 0 ∨ u = h)
    (hne : h ≠ 0) (y base : ZMod (2 ^ t * q))
    (hfullOdd : q / addOrderOf y = 1)
    (B : Finset (Fin (m + 1))) {d : ℕ} (hd : 2 ≤ d)
    (leaf center : Fin d → Fin (m + 1))
    (hleafInj : Function.Injective leaf) (P : Equiv.Perm (Fin d))
    (J : Finset (Fin d)) (R : Equiv.Perm (Fin d))
    (componentThreshold : ℕ)
    (hretained : OddPrimaryFullCycleRetainedExternalChargeDescent
      g y B d leaf)
    (hrows : TwoRetainedMinimalCyclicKernelFiveWeightRows g y B)
    (hminimal : ∀ M : ℕ,
      0 < M → M < 2 ^ t * q → M ∣ 2 ^ t * q →
        ¬ AdmitsValidTuple (m + 1) M)
    (hcenter : ∀ j, center j = leaf (P j))
    (hfrontier :
      TwoRetainedExternalInternalDominantCycleComponentPivotAlignedFrontier
        g y base B leaf center P J R componentThreshold) :
    TwoRetainedPivotAlignedDenseExchangeFamily g y B leaf J ∨
      TwoRetainedDominantExternalCycleComponentArm
        g y base B center P J R componentThreshold := by
  classical
  rcases hretained with
    ⟨⟨hdesc, _hleafAtMostOne, _hleafLower⟩, x, hxB, hxOutside⟩
  rcases hdesc with
    ⟨hmin, _hquotient, _hprivate, _hlower, hyq, _hstrict, _hcharge⟩
  unfold TwoRetainedExternalInternalDominantCycleComponentPivotAlignedFrontier at hfrontier
  rcases hfrontier with
    ⟨scalar, coeff, E, I, supportCoord, hunion, hdisjoint, hcard,
      hlarge, hrowData, hsupport, hdense | hexternal⟩
  · left
    rcases hdense with
      ⟨hIlarge, pivot, p, hpivotB, hpairs, hleafB,
        hPpivot, hpivotLeaf⟩
    have hInonempty : I.Nonempty := by
      rw [← Finset.card_pos]
      omega
    have hpB : leaf p ∉ B := by
      intro hp
      exact (hleafB p).mp hp rfl
    have hpx : leaf p ≠ x := by
      intro heq
      apply hxOutside
      rw [← heq]
      exact Finset.mem_image.mpr ⟨p, Finset.mem_univ _, rfl⟩
    have hcomplementCard : (Finset.univ \ B).card = 2 := by
      rw [Finset.card_sdiff_of_subset (Finset.subset_univ B)]
      simpa using hrows.1
    have hpComplement : leaf p ∈ Finset.univ \ B :=
      Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hpB⟩
    have hxComplement : x ∈ Finset.univ \ B :=
      Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hxB⟩
    have hcomplement : Finset.univ \ B = {leaf p, x} :=
      finset_eq_pair_of_card_eq_two_of_mem
        hcomplementCard hpComplement hxComplement hpx
    let H := AddSubgroup.zmultiples y
    let pi : ZMod (2 ^ t * q) →+ ZMod (2 ^ t * q) ⧸ H :=
      QuotientAddGroup.mk' H
    have horder :
        addOrderOf (pi (g (leaf p) - g x)) = 2 ^ (t - 1) ∨
          addOrderOf (pi (g (leaf p) - g x)) = 2 ^ t := by
      simpa only [H, pi] using
        hrows.retainedDifference_quotientOrder_eq_half_or_full_of_positiveStratum_minimal
          (t := t) (q := q) (by omega) g hg hunique hne y hyq hfullOdd B
            hminimal (leaf p) x hpB hxB hpx hcomplement
    have hhalfTwo : 2 ≤ 2 ^ (t - 1) := by
      have hpow := Nat.pow_le_pow_right (by omega : 0 < (2 : ℕ))
        (show 1 ≤ t - 1 by omega)
      simpa using hpow
    have hfullTwo : 2 ≤ 2 ^ t := by
      have hpow := Nat.pow_le_pow_right (by omega : 0 < (2 : ℕ))
        (show 1 ≤ t by omega)
      simpa using hpow
    have hdeltaNot : g (leaf p) - g x ∉ AddSubgroup.zmultiples y := by
      intro hmem
      have hzero : pi (g (leaf p) - g x) = 0 :=
        (QuotientAddGroup.eq_zero_iff _).2 hmem
      rcases horder with hhalf | hfull
      · rw [hzero] at hhalf
        norm_num at hhalf
        omega
      · rw [hzero] at hfull
        norm_num at hfull
        omega
    refine ⟨scalar, coeff, I, p, x, hIlarge, hInonempty, hleafB,
      hxB, hxOutside, hcomplement, ?_, ?_⟩
    · simpa only [H, pi] using horder
    · intro j
      have hpairLeaf :
          ExactSignedPairWitness g (scalar (j : ↥J) • y)
            (coeff (j : ↥J)) (leaf (j : Fin d)) (leaf p) := by
        simpa only [hcenter, Equiv.apply_symm_apply, hPpivot] using hpairs j
      have hjp : (j : Fin d) ≠ p := by
        intro heq
        apply hpairLeaf.1
        exact congrArg leaf heq
      have hjB : leaf (j : Fin d) ∈ B := (hleafB _).2 hjp
      have hjmem : g (leaf (j : Fin d)) - g (leaf p) ∈
          AddSubgroup.zmultiples y :=
        hpairLeaf.left_sub_right_mem_zmultiples g y
      have hjxNot : g (leaf (j : Fin d)) - g x ∉
          AddSubgroup.zmultiples y := by
        intro hjx
        apply hdeltaNot
        have hsub := (AddSubgroup.zmultiples y).sub_mem hjx hjmem
        convert hsub using 1
        abel
      have hexchange :=
        exists_minimalCyclicKernelTransversal_exchange_of_pairDifference_not_mem_or_three
          g y hmin hrows.1 hjB hpB hxB hpx hcomplement hjxNot
      refine ⟨(hrowData (j : ↥J)).1, hpairLeaf, hjmem, ?_⟩
      rcases hexchange with hthree | hexact
      · exact Or.inl hthree
      · exact Or.inr ⟨hexact.1, hexact.2,
          cycleLeaf_mem_insert_erase_uniqueRetained_iff
            B leaf hleafInj hleafB hjp⟩
  · right
    exact ⟨scalar, coeff, E, I, supportCoord, hunion, hdisjoint, hcard,
      hlarge, hrowData, hsupport, hexternal⟩

variable {m : ℕ}

/-- Public C2 endpoint after the first positive-stratum dense exchange.  A
proper odd-kernel quotient is exposed explicitly.  In the full-odd arm, the
dense pivot branch becomes a literal exchange family while the sparse
external component branch is unchanged. -/
def PureEdgeStarLeafOddPrimaryFullCycleC2DenseExchangeOutcome
    {t q : ℕ} (g : Fin (m + 1) → ZMod (2 ^ t * q))
    (h : ZMod (2 ^ t * q)) (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    (a : ↥(witnessPureEdgeStarLeaves g h r)) (d : ℕ)
    (center : Fin d → Fin (m + 1)) (componentThreshold : ℕ) : Prop :=
  let leaf : Fin d → Fin (m + 1) :=
    fun j ↦ (T^[j.val] a : Fin (m + 1))
  let disp : Fin d → ZMod (2 ^ t * q) :=
    fun j ↦ g (leaf j) - (h + g r)
  2 * d + 1 ≤ m + 1 ∨
    (d + 2 ≤ m + 1 ∧
      ∃ j k ell : Fin d,
        center j = leaf k ∧ center ell ∉ Set.range leaf) ∨
    (PureEdgeStarLeafOddPrimaryCycleLayerChargeOutcome
        g h r T a d center ∧
      ∃ y : ZMod (2 ^ t * q), ∃ B : Finset (Fin (m + 1)),
        ∃ P : Equiv.Perm (Fin d), ∃ J : Finset (Fin d),
          AddSubgroup.closure (Set.range disp) =
            AddSubgroup.zmultiples y ∧
          (∀ j : Fin d, disp j ∈ AddSubgroup.zmultiples y) ∧
          OddPrimaryFullCycleRetainedExternalChargeDescent
            g y B d leaf ∧
          CycleCenterSparseKernelPrivateWitnessFamily
            g y B leaf center P J ∧
          CycleCenterSparseRetainedExternalOrArithmeticPivotStar
            g y B center P J ∧
          CycleCenterSparseRetainedExternalOrCommonPivot
            g y B center P J ∧
          RetainedExternalInternalRowPartition
            g y B center P J ∧
          ∃ S : Equiv.Perm (Fin d),
            (∀ j : Fin d,
              P j ≠ j ∧ P j ≠ S j ∧
              center j = leaf (P j) ∧
              (T (T^[j.val] a) : Fin (m + 1)) = leaf (S j) ∧
              (2 : ℤ) • g (leaf (P j)) =
                h + g r + g (leaf (S j))) ∧
            (∀ j : Fin d,
              disp ((P.symm.trans S) j) = 2 • disp j) ∧
            (2 < m + 1 - B.card ∨
              (TwoRetainedMinimalCyclicKernelPrivateRows g y B ∧
                TwoRetainedMinimalCyclicKernelFiveWeightRows g y B ∧
                ((∀ j : Fin d, leaf j ∈ B) ∨
                  ∃ p : Fin d, ∀ j : Fin d, leaf j ∈ B ↔ j ≠ p) ∧
                (q / addOrderOf y ≠ 1 ∨
                  TwoRetainedPivotAlignedDenseExchangeFamily
                    g y B leaf J ∨
                  TwoRetainedDominantExternalCycleComponentArm
                    g y (h + g r) B center P J (P.symm.trans S)
                      componentThreshold))))

/-- Refine the pivot-aligned public outcome at `t>=2`.  Only the full-odd
exact-two arm uses the minimal-modulus hypothesis; all other branches and all
selected structural data are preserved literally. -/
theorem pureEdgeStarLeafCycle_c2DenseExchangeOutcome_of_pivotAlignmentOutcome
    {t q : ℕ} [NeZero (2 ^ t * q)] (ht : 2 ≤ t)
    (g : Fin (m + 1) → ZMod (2 ^ t * q)) (hg : ValidTuple g)
    {h : ZMod (2 ^ t * q)} (hne : h ≠ 0)
    (hunique : ∀ u : ZMod (2 ^ t * q),
      u + u = 0 → u = 0 ∨ u = h)
    (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    {a : ↥(witnessPureEdgeStarLeaves g h r)} {d : ℕ}
    (hd : 2 ≤ d) (hleafInj : Function.Injective
      (fun j : Fin d ↦ (T^[j.val] a : Fin (m + 1))))
    (center : Fin d → Fin (m + 1)) (componentThreshold : ℕ)
    (hminimal : ∀ M : ℕ,
      0 < M → M < 2 ^ t * q → M ∣ 2 ^ t * q →
        ¬ AdmitsValidTuple (m + 1) M)
    (hout : PureEdgeStarLeafOddPrimaryFullCycleC2PivotAlignmentOutcome
      g h r T a d center componentThreshold) :
    PureEdgeStarLeafOddPrimaryFullCycleC2DenseExchangeOutcome
      g h r T a d center componentThreshold := by
  rcases hout with hcap | hmixed |
      ⟨hcharge, y, B, P, J, hspan, hmem, hretained, hsparse,
        harithmetic, hnormal, hpartition, S, hlocal, hdouble,
        hthree | hexact⟩
  · exact Or.inl hcap
  · exact Or.inr (Or.inl hmixed)
  · exact Or.inr (Or.inr
      ⟨hcharge, y, B, P, J, hspan, hmem, hretained, hsparse,
        harithmetic, hnormal, hpartition, S, hlocal, hdouble,
        Or.inl hthree⟩)
  · rcases hexact with ⟨hprivate, hfive, hleafSplit, hfrontier⟩
    by_cases hfullOdd : q / addOrderOf y = 1
    · let leaf : Fin d → Fin (m + 1) :=
        fun j ↦ (T^[j.val] a : Fin (m + 1))
      have hcenter : ∀ j, center j = leaf (P j) :=
        fun j ↦ (hlocal j).2.2.1
      have hrefined :=
        twoRetainedPivotAligned_positiveStratum_denseExchangeFamily_or_external
          ht g hg hunique hne y (h + g r) hfullOdd B hd leaf center
            hleafInj P J (P.symm.trans S) componentThreshold hretained hfive
              hminimal hcenter hfrontier
      exact Or.inr (Or.inr
        ⟨hcharge, y, B, P, J, hspan, hmem, hretained, hsparse,
          harithmetic, hnormal, hpartition, S, hlocal, hdouble,
          Or.inr ⟨hprivate, hfive, hleafSplit, Or.inr hrefined⟩⟩)
    · exact Or.inr (Or.inr
        ⟨hcharge, y, B, P, J, hspan, hmem, hretained, hsparse,
          harithmetic, hnormal, hpartition, S, hlocal, hdouble,
          Or.inr ⟨hprivate, hfive, hleafSplit, Or.inl hfullOdd⟩⟩)

/-- Global minimal-counterexample constructor for the positive-stratum C2
dense-exchange endpoint. -/
theorem exists_minimal_pureEdgeStarLeafCycle_oddPrimaryFullCycleC2DenseExchangeOutcome
    {t q : ℕ} [NeZero (2 ^ t * q)]
    (ht : 2 ≤ t)
    (g : Fin (m + 1) → ZMod (2 ^ t * q)) (hg : ValidTuple g)
    (hcritical : 2 ^ t * q < stratumBound (m + 1) t)
    (hminimal : ∀ M : ℕ,
      0 < M → M < 2 ^ t * q → M ∣ 2 ^ t * q →
        ¬ AdmitsValidTuple (m + 1) M)
    {h : ZMod (2 ^ t * q)} (hh : h + h = 0) (hne : h ≠ 0)
    (hno : ¬ ∃ z : Fin (m + 1), ∀ c : Fin (m + 1) → ℤ,
      Witness g h c → c z ≠ 0)
    (r : Fin (m + 1))
    (qroot : ReducedSubsetSumCollision g h)
    (hqCanonical : qroot ∈ canonicalReducedCollisions (g := g) hh)
    (hcoeff : subsetCollisionCoeffs qroot.val.1 qroot.val.2 =
        supportAvoidingWitnessAt g hno r ∨
      subsetCollisionCoeffs qroot.val.1 qroot.val.2 =
        -supportAvoidingWitnessAt g hno r)
    (hthree : ¬ WitnessThreeDistinctOmissions g h)
    (hcross : ∀ q' : ReducedSubsetSumCollision g h,
      ¬ ((qroot, q') ∈ canonicalPositiveNegativeCrossPairs (g := g) hh ∨
        (q', qroot) ∈ canonicalPositiveNegativeCrossPairs (g := g) hh))
    (hL : (witnessPureEdgeStarLeaves g h r).Nonempty)
    (componentThreshold : ℕ) :
    ∃ T : ↥(witnessPureEdgeStarLeaves g h r) →
        ↥(witnessPureEdgeStarLeaves g h r),
      ∃ a : ↥(witnessPureEdgeStarLeaves g h r), ∃ d : ℕ,
        ∃ center : Fin d → Fin (m + 1),
          d ≤ (witnessPureEdgeStarLeaves g h r).card ∧
          IsMinimalFixedPointFreeCycle T a d ∧
          Function.Injective center ∧
          (∀ j : Fin d,
            center j ≠ r ∧
            center j ≠ (T^[j.val] a : Fin (m + 1)) ∧
            center j ≠ (T (T^[j.val] a) : Fin (m + 1)) ∧
            (2 : ℤ) • g (center j) =
              h + g r + g (T (T^[j.val] a) : Fin (m + 1))) ∧
          PureEdgeStarLeafOddPrimaryFullCycleC2DenseExchangeOutcome
            g h r T a d center componentThreshold := by
  obtain ⟨T, a, d, center, hdCard, hcycle, hcenter, hcenterSpec, hout⟩ :=
    exists_minimal_pureEdgeStarLeafCycle_oddPrimaryFullCycleC2PivotAlignmentOutcome
      (by omega) g hg hcritical hh hne hno r qroot hqCanonical hcoeff hthree
        hcross hL componentThreshold
  have hN : 2 ^ t * q = 2 * (2 ^ (t - 1) * q) := by
    have htDecomp : t = (t - 1) + 1 := by omega
    calc
      2 ^ t * q = 2 ^ ((t - 1) + 1) * q := by rw [← htDecomp]
      _ = 2 * (2 ^ (t - 1) * q) := by rw [pow_succ]; ring
  have hhCanonical :
      h = ((2 ^ (t - 1) * q : ℕ) : ZMod (2 ^ t * q)) := by
    rcases zmod_eq_zero_or_half_of_add_self_eq_zero hN h hh with
      hzero | hhalf
    · exact (hne hzero).elim
    · exact hhalf
  have hunique : ∀ u : ZMod (2 ^ t * q),
      u + u = 0 → u = 0 ∨ u = h := by
    intro u hu
    rcases zmod_eq_zero_or_half_of_add_self_eq_zero hN u hu with
      hzero | hhalf
    · exact Or.inl hzero
    · exact Or.inr (hhalf.trans hhCanonical.symm)
  let leaf : Fin d → Fin (m + 1) :=
    fun j ↦ (T^[j.val] a : Fin (m + 1))
  have hleafInj : Function.Injective leaf := by
    intro j k hjk
    apply minimalFixedPointFreeCycle_iterates_injective T hcycle
    exact Subtype.ext hjk
  have hout' :=
    pureEdgeStarLeafCycle_c2DenseExchangeOutcome_of_pivotAlignmentOutcome
      ht g hg hne hunique r T hcycle.1 hleafInj center componentThreshold
        hminimal hout
  exact ⟨T, a, d, center, hdCard, hcycle, hcenter, hcenterSpec, hout'⟩

end MinModulus
