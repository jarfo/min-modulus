/-
# Odd projection of closed G1 transport cycles

`G1TransportCycles` proves that a closed restoration cycle has 2-primary
total shift.  In a cyclic ambient group this has a concrete consequence: the
shift vanishes after reduction to every odd divisor of the modulus.

For `N = 2^(s+1)q`, the distinguished half target `2^s q` itself vanishes
modulo `q`.  Hence the odd projection of the restoration label
`h + ssum(B_q ∩ H_q)` retains precisely the projected restoration-support
sum.  A future transport-graph argument can therefore target an explicit
zero relation modulo the odd part rather than an unjustified equality in the
original group.
-/
import MinModulus.G1TransportCycles

namespace MinModulus

variable {G : Type*} [AddCommGroup G]

/-- In a group with injective doubling, no nonzero element is annihilated by
a power of two. -/
theorem eq_zero_of_pow_two_nsmul_eq_zero
    (hinj : ∀ x y : G, x + x = y + y → x = y)
    (d : ℕ) {x : G} (hx : (2 ^ d) • x = 0) : x = 0 := by
  induction d with
  | zero => simpa using hx
  | succ d ih =>
      have hdouble : (2 : ℕ) • ((2 ^ d) • x) = 0 := by
        calc
          (2 : ℕ) • ((2 ^ d) • x) = (2 ^ d * 2) • x :=
            (mul_nsmul x (2 ^ d) 2).symm
          _ = (2 ^ (d + 1)) • x := by rw [pow_succ]
          _ = 0 := hx
      have hsmall : (2 ^ d) • x = 0 := by
        apply hinj ((2 ^ d) • x) 0
        simpa [two_nsmul] using hdouble
      exact ih hsmall

/-- A power-of-two-annihilated element of `ZMod N` vanishes after reduction
to every odd divisor of `N`. -/
theorem zmod_castHom_eq_zero_of_pow_two_nsmul_eq_zero
    {N q d : ℕ} (hqN : q ∣ N) (hq : Odd q)
    (x : ZMod N) (hx : (2 ^ d) • x = 0) :
    ZMod.castHom hqN (ZMod q) x = 0 := by
  letI : NeZero q := ⟨by
    intro hq0
    subst q
    simp at hq⟩
  apply eq_zero_of_pow_two_nsmul_eq_zero (add_self_injective_zmod hq) d
  let f := ZMod.castHom hqN (ZMod q)
  calc
    (2 ^ d) • f x = f ((2 ^ d) • x) := by
      exact (map_nsmul f (2 ^ d) x).symm
    _ = f 0 := by rw [hx]
    _ = 0 := map_zero f

/-- The kernel of reduction `ZMod N → ZMod q` is exactly the subgroup
generated by the residue `q`. -/
theorem zmod_castHom_eq_zero_iff_mem_zmultiples
    {N q : ℕ} [NeZero N] [NeZero q] (hqN : q ∣ N) (x : ZMod N) :
    ZMod.castHom hqN (ZMod q) x = 0 ↔
      x ∈ AddSubgroup.zmultiples ((q : ℕ) : ZMod N) := by
  constructor
  · intro hx
    rw [ZMod.castHom_apply, ← ZMod.natCast_val,
      ZMod.natCast_eq_zero_iff] at hx
    obtain ⟨a, ha⟩ := hx
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨(a : ℤ), ?_⟩
    have hmul : (a : ZMod N) * ((q : ℕ) : ZMod N) =
        ((q * a : ℕ) : ZMod N) := by
      push_cast
      ring
    rw [natCast_zsmul, nsmul_eq_mul, hmul, ← ha,
      ZMod.natCast_zmod_val]
  · intro hx
    obtain ⟨a, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
    rw [map_zsmul, map_natCast, ZMod.natCast_self, smul_zero]

/-- A closed translation path on a power-of-two face has zero total label in
every odd quotient. -/
theorem translateValuePath_oddProjection_sum_eq_zero
    {N q d : ℕ} [NeZero N] (hqN : q ∣ N) (hq : Odd q)
    (A : Finset (ZMod N)) (shifts : List (ZMod N))
    (hcard : A.card = 2 ^ d)
    (hcycle : translateValuePath A shifts = A) :
    ZMod.castHom hqN (ZMod q) shifts.sum = 0 := by
  apply zmod_castHom_eq_zero_of_pow_two_nsmul_eq_zero hqN hq shifts.sum
  have hann := card_nsmul_eq_zero_of_translateValueFinset_eq_self
    A shifts.sum (by
      rw [← translateValuePath_eq_translate_sum]
      exact hcycle)
  rwa [hcard] at hann

section RestorationCycleProjection

variable {m N q : ℕ} [NeZero N]

/-- A closed restoration transport cycle has zero total shift in every odd
quotient of the ambient cyclic group. -/
theorem restorationFanTransportCycle_oddProjection_shift_eq_zero
    (hqN : q ∣ N) (hq : Odd q)
    {g : Fin (m + 1) → ZMod N} (hg : ValidTuple g) {h : ZMod N}
    (r c : ReducedSubsetSumCollision g h)
    (hcard : (reducedCollisionSupport r).card ≤
      (reducedCollisionSupport c).card)
    (hdrop : (reducedCollisionDroppedSupport r c).Nonempty)
    (j k : Fin m) (hAcard : r.val.1.card = 1)
    (hB : r.val.2 = {j, k})
    (hjc : j ∉ reducedCollisionSupport c)
    (hkc : k ∈ c.val.2)
    (hAc : (r.val.1 ∩ c.val.2).Nonempty)
    (e : FinsetAffineTransport (ZMod N))
    (hsource : e.source = restorationFanForcedExcludedValueSlice r c j)
    (hcycle : e.target = e.source) :
    ZMod.castHom hqN (ZMod q) e.shift = 0 := by
  apply zmod_castHom_eq_zero_of_pow_two_nsmul_eq_zero hqN hq e.shift
  exact restorationFanTransportCycle_pow_nsmul_shift_eq_zero
    hg r c hcard hdrop j k hAcard hB hjc hkc hAc e hsource hcycle

/-- Equivalently, the total shift of a closed restoration cycle is an
integer multiple of the odd part inside the original cyclic group. -/
theorem restorationFanTransportCycle_shift_mem_oddPart_zmultiples
    (hqN : q ∣ N) (hq : Odd q)
    {g : Fin (m + 1) → ZMod N} (hg : ValidTuple g) {h : ZMod N}
    (r c : ReducedSubsetSumCollision g h)
    (hcard : (reducedCollisionSupport r).card ≤
      (reducedCollisionSupport c).card)
    (hdrop : (reducedCollisionDroppedSupport r c).Nonempty)
    (j k : Fin m) (hAcard : r.val.1.card = 1)
    (hB : r.val.2 = {j, k})
    (hjc : j ∉ reducedCollisionSupport c)
    (hkc : k ∈ c.val.2)
    (hAc : (r.val.1 ∩ c.val.2).Nonempty)
    (e : FinsetAffineTransport (ZMod N))
    (hsource : e.source = restorationFanForcedExcludedValueSlice r c j)
    (hcycle : e.target = e.source) :
    e.shift ∈ AddSubgroup.zmultiples ((q : ℕ) : ZMod N) := by
  letI : NeZero q := ⟨by
    intro hq0
    subst q
    simp at hq⟩
  rw [← zmod_castHom_eq_zero_iff_mem_zmultiples hqN]
  exact restorationFanTransportCycle_oddProjection_shift_eq_zero
    hqN hq hg r c hcard hdrop j k hAcard hB hjc hkc hAc
      e hsource hcycle

/-- List form of the restoration result: every closed shift path based at a
live excluded face has zero total label in the odd quotient. -/
theorem restorationFanTransportPath_oddProjection_sum_eq_zero
    (hqN : q ∣ N) (hq : Odd q)
    {g : Fin (m + 1) → ZMod N} (hg : ValidTuple g) {h : ZMod N}
    (r c : ReducedSubsetSumCollision g h)
    (hcard : (reducedCollisionSupport r).card ≤
      (reducedCollisionSupport c).card)
    (hdrop : (reducedCollisionDroppedSupport r c).Nonempty)
    (j k : Fin m) (hAcard : r.val.1.card = 1)
    (hB : r.val.2 = {j, k})
    (hjc : j ∉ reducedCollisionSupport c)
    (hkc : k ∈ c.val.2)
    (hAc : (r.val.1 ∩ c.val.2).Nonempty)
    (shifts : List (ZMod N))
    (hcycle : translateValuePath
      (restorationFanForcedExcludedValueSlice r c j) shifts =
        restorationFanForcedExcludedValueSlice r c j) :
    ZMod.castHom hqN (ZMod q) shifts.sum = 0 := by
  apply translateValuePath_oddProjection_sum_eq_zero hqN hq
    (restorationFanForcedExcludedValueSlice r c j) shifts
  · exact card_restorationFanForcedExcludedValueSlice_eq_pow
      hg r c hcard hdrop j k hAcard hB hjc hkc hAc
  · exact hcycle

/-- The distinguished half element in `ZMod (2^(s+1)q)` vanishes on
reduction to the odd part `ZMod q`. -/
theorem zmod_castHom_halfPower_eq_zero (s q : ℕ) :
    ZMod.castHom
      (show q ∣ 2 ^ (s + 1) * q by
        exact ⟨2 ^ (s + 1), by ac_rfl⟩)
      (ZMod q) ((2 ^ s * q : ℕ) : ZMod (2 ^ (s + 1) * q)) = 0 := by
  rw [map_natCast, ZMod.natCast_eq_zero_iff]
  exact ⟨2 ^ s, by ac_rfl⟩

/-- On the odd quotient, a restoration collision shift retains only the
negative-tail restoration sum; its half-target summand disappears. -/
theorem zmod_castHom_restorationFanCollisionShift_half
    {s q : ℕ}
    {g : Fin (m + 1) → ZMod (2 ^ (s + 1) * q)}
    (r c : ReducedSubsetSumCollision g
      ((2 ^ s * q : ℕ) : ZMod (2 ^ (s + 1) * q))) :
    ZMod.castHom
        (show q ∣ 2 ^ (s + 1) * q by
          exact ⟨2 ^ (s + 1), by ac_rfl⟩)
        (ZMod q) (restorationFanCollisionShift r c) =
      ZMod.castHom
        (show q ∣ 2 ^ (s + 1) * q by
          exact ⟨2 ^ (s + 1), by ac_rfl⟩)
        (ZMod q)
        (ssum g (c.val.2 ∩ reducedCollisionRestorationFanSupport r c)) := by
  rw [restorationFanCollisionShift, map_add,
    zmod_castHom_halfPower_eq_zero, zero_add]

end RestorationCycleProjection

end MinModulus
