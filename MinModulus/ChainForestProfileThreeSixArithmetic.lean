import MinModulus.ChainForestProfileFourFive

/-! Complete primitive arithmetic for companion lengths three and six.
All 708 nonintegral phases have complementary certificates with variable
prefix widths and error constants; six integral phases have sparse-tail
certificates. A checked bound at the original orientation cost threshold
propagates to every larger length. Actual group rivals and full-length
coin representations are produced. The genuine-forest consumer is a
separate step, and the unrestricted conjecture remains open. -/

namespace MinModulus

/-- A checked linear-error bound at one length propagates to all larger
lengths, with an arbitrary fixed number of reserved upper positions. -/
theorem linear_error_lt_two_pow_sub_of_base
    {n n₀ C d : ℕ} (hn₀ : 1 ≤ n₀) (hn : n₀ ≤ n) (hd : d ≤ n₀)
    (hbase : C*n₀ < 2^(n₀-d)) : C*n < 2^(n-d) := by
  induction n, hn using Nat.le_induction with
  | base => exact hbase
  | succ n hn ih =>
    rw [show n+1-d=(n-d)+1 by omega,pow_succ]
    have hh : C ≤ C*n := by
      have hh := Nat.mul_le_mul_left C (show 1 ≤ n by omega)
      simpa only [Nat.mul_one] using hh
    nlinarith only [ih,hh]

/-- A finite base-length error certificate supplies the entire lower
block for a complementary pair at every larger length. Prefix width and
error constant can vary with the chosen pair. -/
theorem exists_one_complementary_representation_of_base_bound
    {n n₀ L bits d m T R₁ R₂ U C₁ C₂ : ℕ} (Z₁ Z₂ : ℤ)
    (hn₀ : 1 ≤ n₀) (hn : n₀ ≤ n) (hL : L+d=n)
    (hbits : 1 ≤ bits) (hreserved : d+bits ≤ n₀) (hU : 0 < U)
    (hbase : U*n₀ < 2^(n₀-(d+bits)))
    (hT : 0 < T) (hThi : T ≤ 2^bits) (hR₁ : 0 < R₁) (hR₂ : 0 < R₂)
    (hRsum : R₁+R₂=m*T) (hrem : 0 < (R₁*2^bits)%T)
    (hcost : C₁+C₂+2*m ≤ bits+2*d+3)
    (hw₁ : (R₁ : ℤ)*2^L < T*Z₁+(U*n : ℕ) ∧ T*Z₁ < (R₁ : ℤ)*2^L+(U*n : ℕ))
    (hw₂ : (R₂ : ℤ)*2^L < T*Z₂+(U*n : ℕ) ∧ T*Z₂ < (R₂ : ℤ)*2^L+(U*n : ℕ)) :
    (0 ≤ Z₁ ∧ n ≤ Z₁.toNat ∧ ∃ u, val L u=Z₁.toNat ∧ dsum L u+C₁ ≤ n) ∨
    (0 ≤ Z₂ ∧ n ≤ Z₂.toNat ∧ ∃ u, val L u=Z₂.toNat ∧ dsum L u+C₂ ≤ n) := by
  have hsmall : U*n < 2^(L-bits) := by
    rw [show L-bits=n-(d+bits) by omega]
    exact linear_error_lt_two_pow_sub_of_base hn₀ hn hreserved hbase
  have hlarge : n ≤ 2^(L-bits) := by
    have hh := Nat.mul_le_mul_right n hU
    omega
  exact exists_one_complementary_representation_of_combined_cost
    (n:=n) (L:=L) (e:=L-bits) (w:=bits-1) (d:=d) Z₁ Z₂ (by omega) hL
    hT (by simpa only [Nat.sub_add_cancel hbits] using hThi) hR₁ hR₂ hRsum
    (by simpa only [Nat.sub_add_cancel hbits] using hrem) (by omega) hsmall hlarge hw₁ hw₂

structure ThreeSixPairPlan where
  κ : ℤ
  ν : ℤ
  mp : ℕ
  mm : ℕ
  Rp : ℕ
  Rm : ℕ
  ap : ℕ
  am : ℕ
  bits : ℕ
  U : ℕ
  deriving DecidableEq

def ThreeSixPairCertificate (D F n₀ : ℕ) (P r : ℤ) (p : ThreeSixPairPlan) : Prop :=
  let S : ℤ := 119*F
  let W : ℤ := 128*F
  let J := p.κ*r-S*p.ν
  let Ap := S*(1-p.mp)+p.κ*P
  let Bp := S*(1-p.mp)-32*p.κ
  let Am := S*(1-p.mm)-p.κ*P
  let Bm := S*(1-p.mm)+32*p.κ
  67 ≤ n₀ ∧ 1 ≤ p.bits ∧ 9+p.bits ≤ n₀ ∧ 119*F ≤ 2^p.bits ∧
  0 < p.U ∧ p.U*n₀ < 2^(n₀-(9+p.bits)) ∧
  (p.ap : ℤ)=D*p.κ+7*p.mp ∧
  (p.am : ℤ)=-(D : ℤ)*p.κ+7*p.mm ∧
  (p.ap ≠ 7 ∨ 63*p.mp ≠ 63) ∧
  (p.am ≠ 7 ∨ 63*p.mm ≠ 63) ∧
  (p.Rp : ℤ)=-p.κ*(P+W*r)+S*p.ν*W+S*p.mp ∧
  (p.Rm : ℤ)=p.κ*(P+W*r)-S*p.ν*W+S*p.mm ∧
  0 < p.Rp ∧ 0 < p.Rm ∧ p.Rp+p.Rm=(p.mp+p.mm)*(119*F) ∧
  0 < (p.Rp*2^p.bits)%(119*F) ∧
  (gmin 2 p.ap+gmin 5 (63*p.mp))+(gmin 2 p.am+gmin 5 (63*p.mm))+
    2*(p.mp+p.mm) ≤ p.bits+21 ∧
  -(p.U : ℤ) < Ap-S+min J 0*(32*F) ∧ -(p.U : ℤ) ≤ Bp ∧
  Ap+max J 0*(32*F) ≤ (p.U : ℤ) ∧ Bp ≤ (p.U : ℤ) ∧
  -(p.U : ℤ) < Am-S+min (-J) 0*(32*F) ∧ -(p.U : ℤ) ≤ Bm ∧
  Am+max (-J) 0*(32*F) ≤ (p.U : ℤ) ∧ Bm ≤ (p.U : ℤ)

instance (D F n₀ : ℕ) (P r : ℤ) (p : ThreeSixPairPlan) :
    Decidable (ThreeSixPairCertificate D F n₀ P r p) := by
  unfold ThreeSixPairCertificate
  infer_instance

