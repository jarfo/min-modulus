/-- All six integral three-six phases have checked sparse certificates,
with the short orientation retaining its positive second-phase endpoint. -/
theorem exists_three_six_integral_certificate
    {D F r q : ℕ} {P Q : ℤ}
    (hcases : (D=2 ∧ F=2) ∨ (D=4 ∧ F=1))
    (hr : (P=31 ∧ Q = -5 ∧ r < 119*F ∧ 1 ≤ q ∧ q ≤ 119) ∨
      (P = -95 ∧ Q=23 ∧ 1 ≤ r ∧ r ≤ 119*F ∧ q < 119))
    (hlink : (4*r+q)%119=0) (hint : (P+(128*F : ℕ)*r)%119=0) :
    ∃ p, ThreeSixIntegralCertificate D F P Q r q p := by
  rcases hcases with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
    · exact ⟨_,threeSixIntegral10_checked ⟨r,by omega⟩ (by change r < _; omega)
        (by simpa using hint) ⟨q,by omega⟩ (by change 0 < q; omega) hlink⟩
    · exact ⟨_,threeSixIntegral11_checked ⟨r,by omega⟩ (by change 0 < r; omega)
        (by simpa using hint) ⟨q,by omega⟩ (by omega) hlink⟩
  · rcases hr with ⟨rfl,rfl,hr,hqlo,hqhi⟩ | ⟨rfl,rfl,hrlo,hrhi,hq⟩
    · exact ⟨_,threeSixIntegral20_checked ⟨r,by omega⟩ (by change r < _; omega)
        (by simpa using hint) ⟨q,by omega⟩ (by change 0 < q; omega) hlink⟩
    · exact ⟨_,threeSixIntegral21_checked ⟨r,by omega⟩ (by change 0 < r; omega)
        (by simpa using hint) ⟨q,by omega⟩ (by omega) hlink⟩
/-- A checked integral plan gives an actual sparse rival uniformly in
length, without requiring the period coprime to the primitive denominator. -/
theorem exists_three_six_rival_of_integral_certificate
    {n N L D F M E H c V α z : ℕ} {P Q r q : ℤ}
    (hn : 67 ≤ n) (hL : L+9=n) (hF : 1 ≤ F)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(128*F)*2^L) (hE : E ≤ (32*F)*H)
    (hphase : (119*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+32*c+r*M)
    (hzphase : 119*(z : ℤ)=Q*(2 : ℤ)^L+(119-Q)*H+110*c-119+q*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (hz : z • x+a+b=V • x) (hmx : M • x=0)
    (p : ThreeSixIntegralPlan) (hp : ThreeSixIntegralCertificate D F P Q r q p) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 7 ∨ tb ≠ 63) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 2 ta+gmin 5 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  rcases hp with ⟨hta,hne,hR,hb,hbp,hflo,hfhi,hcost,hA0,hB0,hpos,hA1,hB1⟩
  let Z : ℤ := (p.tb : ℤ)*z-p.κ*α+(1-(p.tb : ℤ))*V-p.ν*M
  have hS : 0 < 119*F := by omega
  have hbaseZ : (H : ℤ)+c=V+1 := by exact_mod_cast hbase
  have hMZ : (M : ℤ)+E=(128*F : ℕ)*(2 : ℤ)^L := by exact_mod_cast hM
  have herr : (119*F : ℕ)*Z-(p.R : ℤ)*2^L =
      ((119*F : ℕ)-(F : ℤ)*p.tb*Q+p.κ*P)*H+
      ((119*F : ℕ)-9*(F : ℤ)*p.tb-32*p.κ)*c-(119*F : ℕ)+
      ((119*F : ℕ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*E := by
    dsimp [Z]
    push_cast at hphase hMZ ⊢
    linear_combination (F : ℤ)*p.tb*hzphase-p.κ*hphase-
      (119*(F : ℤ))*(1-(p.tb : ℤ))*hbaseZ-
      (119*(F : ℤ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*hMZ-hR*(2 : ℤ)^L
  have he : L-p.f+(p.f-1+1)=L := by omega
  have hpow : 2^L=2^p.f*2^(L-p.f) := by
    rw [← pow_add,show p.f+(L-p.f)=L by omega]
  have hboundaryeq : (119*F : ℕ)*(p.b*2^(L-p.f) : ℕ)=(p.R : ℤ)*2^L := by
    have hh : (119*F)*(p.b*2^(L-p.f))=p.R*2^L := by
      rw [← Nat.mul_assoc,hb,hpow]
      ring
    exact_mod_cast hh
  have htail := two_thousand_length_lt_two_pow_sub_forty hn
  have hboundary : n ≤ p.b*2^(L-p.f) := by
    have hh := Nat.pow_le_pow_right (by decide : 0 < 2) (show n-40 ≤ L-p.f by omega)
    have hh' := Nat.mul_le_mul_right (2^(L-p.f)) hbp
    omega
  have hsmall : (2000*(119*F))*n ≤ (119*F)*2^(n-40) := by
    have hh := Nat.mul_le_mul_left (119*F) (le_of_lt htail)
    nlinarith only [hh]
  have hcost' : gmin (p.f-1) p.b+(n-40)+(gmin 2 p.ta+gmin 5 p.tb) ≤ n := by omega
  have herr' : (119*F : ℕ)*(Z-(p.b*2^(L-p.f) : ℕ))=
      ((119*F : ℕ)-(F : ℤ)*p.tb*Q+p.κ*P)*H+
      ((119*F : ℕ)-9*(F : ℤ)*p.tb-32*p.κ)*c-(119*F : ℕ)+
      ((119*F : ℕ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*E := by
    linear_combination herr-hboundaryeq
  obtain ⟨hZ,hnZ,u,hu,hcu⟩ := exists_rep_of_integral_rival_error_certificate
    (L:=L) (w:=p.f-1) (e:=L-p.f) (k:=n-40) Z he (by omega) hS hboundary hcost' hsmall
    hH hc hnc hE
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hA0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hB0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hpos)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hA1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hB1) herr'
  refine ⟨Z.toNat,p.ta,p.tb,hnZ,hne,u,hu,by omega,?_⟩
  exact signed_axis_basis_rival_eq x a b p.κ p.ν hta hz hα hmx hZ


/-- Every three-six primitive phase gives an actual affordable rival.
The short orientation starts at length 67 and the long at its original
cost threshold 99. All 714 phases, including all six integral ones, occur. -/
theorem exists_three_six_primitive_rival
    {n n₀ N L D F M E H c V α z r q : ℕ} {P Q : ℤ}
    (hn : n₀ ≤ n) (hL : L+9=n)
    (hcases : (D=2 ∧ F=2) ∨ (D=4 ∧ F=1))
    (horient : (P=31 ∧ Q = -5 ∧ n₀=67 ∧ r < 119*F ∧ 1 ≤ q ∧ q ≤ 119) ∨
      (P = -95 ∧ Q=23 ∧ n₀=99 ∧ 1 ≤ r ∧ r ≤ 119*F ∧ q < 119))
    (hlink : (4*r+q)%119=0)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(128*F)*2^L) (hE : E ≤ (32*F)*H)
    (hphase : (119*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+32*c+(r : ℤ)*M)
    (hzphase : 119*(z : ℤ)=Q*(2 : ℤ)^L+(119-Q)*H+110*c-119+(q : ℤ)*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (htop : (2^L-1) • x+7 • a+63 • b=V • x)
    (hz : z • x+a+b=V • x) (hmx : M • x=0) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 7 ∨ tb ≠ 63) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 2 ta+gmin 5 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  have hF : 1 ≤ F := by rcases hcases with h | h <;> omega
  have hn67 : 67 ≤ n := by rcases horient with h | h <;> omega
  by_cases hint : (P+(128*F : ℕ)*r)%119=0
  · have hr : (P=31 ∧ Q = -5 ∧ r < 119*F ∧ 1 ≤ q ∧ q ≤ 119) ∨
        (P = -95 ∧ Q=23 ∧ 1 ≤ r ∧ r ≤ 119*F ∧ q < 119) := by
      rcases horient with ⟨hP,hQ,_,hr,hqlo,hqhi⟩ | ⟨hP,hQ,_,hrlo,hrhi,hq⟩
      · exact Or.inl ⟨hP,hQ,hr,hqlo,hqhi⟩
      · exact Or.inr ⟨hP,hQ,hrlo,hrhi,hq⟩
    obtain ⟨p,hp⟩ := exists_three_six_integral_certificate hcases hr hlink hint
    exact exists_three_six_rival_of_integral_certificate hn67 hL hF hH hc hnc hbase
      hM hE hphase hzphase x a b hα hz hmx p hp
  · have hr : (P=31 ∧ n₀=67 ∧ r < 119*F) ∨
        (P = -95 ∧ n₀=99 ∧ 1 ≤ r ∧ r ≤ 119*F) := by
      rcases horient with ⟨hP,_,hn₀,hr,_,_⟩ | ⟨hP,_,hn₀,hlo,hhi,_⟩
      · exact Or.inl ⟨hP,hn₀,hr⟩
      · exact Or.inr ⟨hP,hn₀,hlo,hhi⟩
    obtain ⟨p,hp⟩ := exists_three_six_nonintegral_pair_certificate hcases hr hint
    exact exists_three_six_rival_of_pair_certificate hn hL hF hH hnc hbase
      hM hE hphase x a b hα htop hmx p hp

end MinModulus
