    (hcases : (D=2 ∧ F=2) ∨ (D=4 ∧ F=1))
    (hr : (P=31 ∧ n₀=67 ∧ r < 119*F) ∨ (P = -95 ∧ n₀=99 ∧ 1 ≤ r ∧ r ≤ 119*F))
    (hnon : (P+(128*F : ℕ)*r)%119 ≠ 0) :
    ∃ p, ThreeSixPairCertificate D F n₀ P r p := by
  rcases hcases with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · rcases hr with ⟨rfl,rfl,hr⟩ | ⟨rfl,rfl,hrlo,hrhi⟩
    · exact ⟨_,threeSixPair10_checked ⟨r,by omega⟩ (by change r < _; omega) (by simpa using hnon)⟩
    · exact ⟨_,threeSixPair11_checked ⟨r,by omega⟩ (by change 0 < r; omega) (by simpa using hnon)⟩
  · rcases hr with ⟨rfl,rfl,hr⟩ | ⟨rfl,rfl,hrlo,hrhi⟩
    · exact ⟨_,threeSixPair20_checked ⟨r,by omega⟩ (by change r < _; omega) (by simpa using hnon)⟩
    · exact ⟨_,threeSixPair21_checked ⟨r,by omega⟩ (by change 0 < r; omega) (by simpa using hnon)⟩
/-- A checked complementary plan produces an actual affordable rival
for every length and every allowed height, drop and deficit. -/
theorem exists_three_six_rival_of_pair_certificate
    {n n₀ N L D F M E H c V α : ℕ} {P r : ℤ}
    (hn : n₀ ≤ n) (hL : L+9=n) (hF : 1 ≤ F)
    (hH : 1 ≤ H) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(128*F)*2^L) (hE : E ≤ (32*F)*H)
    (hphase : (119*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+32*c+r*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (htop : (2^L-1) • x+7 • a+63 • b=V • x) (hmx : M • x=0)
    (p : ThreeSixPairPlan) (hp : ThreeSixPairCertificate D F n₀ P r p) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 7 ∨ tb ≠ 63) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 2 ta+gmin 5 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  rcases hp with ⟨hn₀,hbits,hreserved,hThi,hU,hbasebound,hap,ham,hnep,hnem,hRp,hRm,hRpp,hRmp,hRsum,hrem,hcost,
    hAp0,hBp0,hAp1,hBp1,hAm0,hBm0,hAm1,hBm1⟩
  let Zp : ℤ := -p.κ*α+p.ν*M+(p.mp : ℤ)*((2 : ℤ)^L-1-V)+V
  let Zm : ℤ := -(-p.κ)*α+(-p.ν)*M+(p.mm : ℤ)*((2 : ℤ)^L-1-V)+V
  have hwpos : (0 : ℤ) ≤ p.U := by positivity
  have hS : 0 < 119*F := by omega
  have hRp' : (p.Rp : ℤ)=-p.κ*(P+(128*F : ℕ)*r)+
      (119*F : ℕ)*p.ν*(128*F : ℕ)+(119*F : ℕ)*p.mp := by
    push_cast
    exact hRp
  have hRm' : (p.Rm : ℤ)=-(-p.κ)*(P+(128*F : ℕ)*r)+
      (119*F : ℕ)*(-p.ν)*(128*F : ℕ)+(119*F : ℕ)*p.mm := by
    push_cast
    nlinarith only [hRm]
  have hep := signed_axis_multiple_top_shift_error (t:=32) hbase hM (by simpa only [Nat.cast_pow,Nat.cast_ofNat] using hphase) hRp'
  have hem := signed_axis_multiple_top_shift_error (t:=32) hbase hM (by simpa only [Nat.cast_pow,Nat.cast_ofNat] using hphase) hRm'
  have hwp := signed_rival_linear_error_window
    (A := (119*F : ℕ)*(1-(p.mp : ℤ))+p.κ*P)
    (B := (119*F : ℕ)*(1-(p.mp : ℤ))-32*p.κ)
    (J := p.κ*r-(119*F : ℕ)*p.ν) hH hnc hE hS hwpos
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAp0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBp0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAp1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBp1)
  have hwm := signed_rival_linear_error_window
    (A := (119*F : ℕ)*(1-(p.mm : ℤ))-p.κ*P)
    (B := (119*F : ℕ)*(1-(p.mm : ℤ))+32*p.κ)
    (J := -(p.κ*r-(119*F : ℕ)*p.ν)) hH hnc hE hS hwpos
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAm0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBm0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAm1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBm1)
  have hwp' : (p.Rp : ℤ)*2^L < (119*F : ℕ)*Zp+(p.U*n : ℕ) ∧
      (119*F : ℕ)*Zp < (p.Rp : ℤ)*2^L+(p.U*n : ℕ) := by
    dsimp [Zp]
    push_cast at hep ⊢
    push_cast at hwp
    constructor <;> linarith only [hep,hwp.1,hwp.2]
  have hwm' : (p.Rm : ℤ)*2^L < (119*F : ℕ)*Zm+(p.U*n : ℕ) ∧
      (119*F : ℕ)*Zm < (p.Rm : ℤ)*2^L+(p.U*n : ℕ) := by
    dsimp [Zm]
    push_cast at hem ⊢
    push_cast at hwm
    constructor <;> linarith only [hem,hwm.1,hwm.2]
  have hh := exists_one_complementary_representation_of_base_bound
    (n:=n) (n₀:=n₀) (L:=L) (bits:=p.bits) (d:=9) Zp Zm (by omega) hn hL
    hbits hreserved hU hbasebound hS hThi hRpp hRmp hRsum hrem hcost hwp' hwm'
  rcases hh with ⟨hZ,hnZ,u,hu,hc⟩ | ⟨hZ,hnZ,u,hu,hc⟩
  · refine ⟨Zp.toNat,p.ap,63*p.mp,hnZ,hnep,u,hu,by omega,?_⟩
    exact signed_axis_multiple_top_shift_rival_eq Nat.one_le_two_pow x a b p.κ p.ν p.mp
      (by push_cast; nlinarith only [hap]) (by push_cast; ring) hα htop hmx (by simpa only [Zp,Zm,Nat.cast_pow,Nat.cast_ofNat] using hZ)
  · refine ⟨Zm.toNat,p.am,63*p.mm,hnZ,hnem,u,hu,by omega,?_⟩
    apply signed_axis_multiple_top_shift_rival_eq Nat.one_le_two_pow x a b (-p.κ) (-p.ν) p.mm
      (by push_cast; nlinarith only [ham]) (by push_cast; ring) hα htop hmx (by simpa only [Zp,Zm,Nat.cast_pow,Nat.cast_ofNat] using hZ)


structure ThreeSixIntegralPlan where
  κ : ℤ
  ν : ℤ
  ta : ℕ
  tb : ℕ
  R : ℕ
  b : ℕ
  f : ℕ
  deriving DecidableEq

def ThreeSixIntegralCertificate (D F : ℕ) (P Q r q : ℤ)
    (p : ThreeSixIntegralPlan) : Prop :=
  let S : ℤ := 119*F
  let W : ℤ := 128*F
  let A := S-F*p.tb*Q+p.κ*P
  let B := S-9*F*p.tb-32*p.κ
  let J := S*p.ν-F*p.tb*q+p.κ*r
  (p.ta : ℤ)=p.tb+D*p.κ ∧ (p.ta ≠ 7 ∨ p.tb ≠ 63) ∧
  (p.R : ℤ)=F*p.tb*(Q+W*q)-p.κ*(P+W*r)-S*p.ν*W ∧
  (119*F)*p.b=2^p.f*p.R ∧ 1 ≤ p.b ∧ 1 ≤ p.f ∧ p.f ≤ 2 ∧
  gmin (p.f-1) p.b+gmin 2 p.ta+gmin 5 p.tb ≤ 40 ∧
  0 ≤ A+min J 0*(32*F) ∧ 0 ≤ B ∧ 0 < A+min J 0*(32*F)+B ∧
  A+max J 0*(32*F) ≤ 2000*(119*F) ∧ B ≤ 2000*(119*F)

instance (D F : ℕ) (P Q r q : ℤ) (p : ThreeSixIntegralPlan) :
    Decidable (ThreeSixIntegralCertificate D F P Q r q p) := by
  unfold ThreeSixIntegralCertificate
  infer_instance

