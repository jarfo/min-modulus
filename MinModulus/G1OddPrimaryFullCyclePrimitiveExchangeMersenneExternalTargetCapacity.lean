/-
# Target capacity of the complete Mersenne external fiber

Canonical private rows with owner coefficient `-1` and one fixed normalized
weight have identical coefficients at both retained coordinates.  Two
different owners also vanish at each other's deleted coordinates.  Thus, if
their nonzero kernel targets agreed, validity would force a coefficient gap
of two at a coordinate where the two rows differ by at most one.  This is
impossible, so the target map is injective.

Applied to the complete secondary fiber in the exact Mersenne endpoint, this
puts the already quantified adjacent/antipodal charge on the same fiber as
the sharp cyclic target capacity `|T| <= addOrderOf y - 1`.
-/
import MinModulus.G1OddPrimaryFullCyclePrimitiveExchangeMersenneResidualMatrixCharge

namespace MinModulus

open Finset

variable {G : Type*} [AddCommGroup G]

/-- Fixed-weight canonical private rows with owner coefficient `-1` have
pairwise distinct nonzero kernel targets. -/
theorem TwoRetainedCanonicalPrivatePresentation.fixedWeight_negOne_target_injective
    {n : ℕ} (g : Fin n → G) (hg : ValidTuple g)
    (y : G) (B : Finset (Fin n))
    (p : TwoRetainedCanonicalPrivatePresentation g y B)
    (S : Finset ↥B) (k : ℤ)
    (howner : ∀ b, b ∈ S → p.coeff b (b : Fin n) = -1)
    (hweight : ∀ b, b ∈ S → p.weight b = 2 * k) :
    Function.Injective (fun b : ↥S ↦ p.scalar (b : ↥B) • y) := by
  intro b c htarget
  by_contra hbc
  have howners : (b : ↥B) ≠ (c : ↥B) := by
    intro h
    exact hbc (Subtype.ext h)
  have hcoeffNe : p.coeff (b : ↥B) ≠ p.coeff (c : ↥B) := by
    intro h
    exact howners (p.coeff_injective h)
  have hcWitness : Witness g (p.scalar (b : ↥B) • y)
      (p.coeff (c : ↥B)) := by
    simpa only [htarget] using p.isWitness (c : ↥B)
  obtain ⟨i, hi⟩ := exists_coefficient_add_two_le_of_distinct_witnesses
    g hg (p.isWitness (b : ↥B)) hcWitness hcoeffNe
  have hbOwner := howner (b : ↥B) b.property
  have hcOwner := howner (c : ↥B) c.property
  have hbRetained := p.retained_coefficients_of_owner_eq_neg_one
    g y B (b : ↥B) k hbOwner (hweight (b : ↥B) b.property)
  have hcRetained := p.retained_coefficients_of_owner_eq_neg_one
    g y B (c : ↥B) k hcOwner (hweight (c : ↥B) c.property)
  by_cases hiB : i ∈ B
  · by_cases hic : i = ((c : ↥B) : Fin n)
    · have hib : i ≠ ((b : ↥B) : Fin n) := by
        intro hib
        apply howners
        apply Subtype.ext
        exact hib.symm.trans hic
      have hbZero := p.zero_other (b : ↥B) i hiB hib
      rw [hbZero, hic, hcOwner] at hi
      omega
    · have hcZero := p.zero_other (c : ↥B) i hiB hic
      have hbFloor := (p.isWitness (b : ↥B)).2.1 i
      rw [hcZero] at hi
      omega
  · have hiComplement : i ∈ Finset.univ \ B :=
      Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hiB⟩
    have hiRetained : i = p.x ∨ i = p.z := by
      have : i ∈ ({p.x, p.z} : Finset (Fin n)) := by
        rw [← p.complement_eq]
        exact hiComplement
      simpa only [Finset.mem_insert, Finset.mem_singleton] using this
    rcases hiRetained with hix | hiz
    · rw [hix, hbRetained.1, hcRetained.1] at hi
      omega
    · rw [hiz, hbRetained.2, hcRetained.2] at hi
      omega

/-- The target-injective fixed-weight family fits in the punctured cyclic
subgroup generated by `y`. -/
theorem TwoRetainedCanonicalPrivatePresentation.card_fixedWeight_negOne_le_order_sub_one
    {n : ℕ} [Fintype G] (g : Fin n → G) (hg : ValidTuple g)
    (y : G) (B : Finset (Fin n))
    (p : TwoRetainedCanonicalPrivatePresentation g y B)
    (S : Finset ↥B) (k : ℤ)
    (howner : ∀ b, b ∈ S → p.coeff b (b : Fin n) = -1)
    (hweight : ∀ b, b ∈ S → p.weight b = 2 * k) :
    S.card ≤ addOrderOf y - 1 := by
  have hcard := card_le_addOrderOf_sub_one_of_injective_nonzero_zsmul y
    (fun b : ↥S ↦ p.scalar (b : ↥B))
    (fun b ↦ p.target_ne_zero (b : ↥B))
    (p.fixedWeight_negOne_target_injective
      g hg y B S k howner hweight)
  simpa only [Fintype.card_coe] using hcard

/-- The exact Mersenne secondary fiber simultaneously satisfies its
adjacent/antipodal incidence charge and the sharp nonzero-target capacity.
No target-counting information is lost when the repair trichotomy is
introduced. -/
theorem PrimitiveMiddleExactMersenneFiveExternalRows.secondaryFiber_charge_with_targetCapacity
    {n d q : ℕ} [NeZero (2 ^ 6 * q)]
    (g : Fin n → ZMod (2 ^ 6 * q)) (hg : ValidTuple g)
    (y root v : ZMod (2 ^ 6 * q)) (B : Finset (Fin n))
    (p : TwoRetainedCanonicalPrivatePresentation g y B)
    (hyq : addOrderOf y ∣ q) (hfullOdd : q / addOrderOf y = 1)
    (hprimitive :
      let H := AddSubgroup.zmultiples y
      let pi : ZMod (2 ^ 6 * q) →+ ZMod (2 ^ 6 * q) ⧸ H :=
        QuotientAddGroup.mk' H
      addOrderOf (pi (g p.x - g p.z)) = 64)
    (hd : 3 ≤ d) (hv : addOrderOf v = 2 ^ d - 1)
    (leaf : Fin d → Fin n) (hleaf : Function.Injective leaf)
    (e : Fin d ≃ Fin d)
    (hnormal : ∀ i, g (leaf (e i)) = root + a i.val • v)
    (hcyclic : AddSubgroup.zmultiples v = AddSubgroup.zmultiples y)
    (r : Fin n) (hrzero : leaf (e ⟨0, by omega⟩) = r)
    (hdeleted : ∀ i,
      i ∈ (Finset.univ : Finset (Fin d)).image leaf → i ≠ r → i ∈ B)
    (hleafMem : ∀ i,
      leaf (e i) ∈ B ↔ i ≠ ⟨0, by omega⟩)
    (k₀ : ℤ) (hmiddle : k₀ = -1 ∨ k₀ = 0)
    (hprimaryWeight : ∀ i, ∀ hi : leaf (e i) ∈ B,
      p.weight ⟨leaf (e i), hi⟩ = 2 * k₀)
    (hr : r = if k₀ = -1 then p.x else p.z)
    (L : Finset (Fin n))
    (hL : L = (Finset.univ : Finset (Fin d)).image leaf)
    (hfive : PrimitiveMiddleExactMersenneFiveExternalRows g y B L p k₀) :
    ∃ T : Finset (Fin n),
      3 ≤ T.card ∧ T ⊆ B \ L ∧ T.card ≤ addOrderOf y - 1 ∧
      (let f : Fin d → Fin n := fun i ↦ leaf (e i)
       let E := deletedOwnerSubfiber B T
       (∀ b, b ∈ E → MersenneLeafAdjacentHeavyRow g y v B p leaf b) ∨
         E.card ≤
           (ownersSatisfying E (fun b ↦ AntipodalRepairRootCommonOmission
             g (p.scalar b • y) r)).card +
           (ownersSatisfying E (fun b ↦ AntipodalRepairPrimaryOmissionCharge
             g y B p f ⟨0, by omega⟩ r (p.scalar b • y))).card + 1 +
           (ownersSatisfying E (fun b ↦ AntipodalRepairResidualMatrix
             g y B p f ⟨0, by omega⟩ r v b)).card) := by
  rcases hfive with
    ⟨T, k, _t, _F, hTcard, _hTle, _hFle, hTsub, _htT,
      _hkMem, _hkNe, hparameter, hrows, _hTexact, _hTadjacent,
      _hTcomplete, _hTseparated, _hpartition, _hdisjoint,
      _hcard, _hprofiles, _hFcase, _hcap, _hcritical⟩
  let E := deletedOwnerSubfiber B T
  have hTsubB : T ⊆ B := fun i hi ↦ (Finset.mem_sdiff.mp (hTsub hi)).1
  have hEcard : E.card = T.card := by
    simpa only [E] using card_deletedOwnerSubfiber B T hTsubB
  have howner : ∀ b, b ∈ E → p.coeff b (b : Fin n) = -1 := by
    intro b hbE
    have hbT := (mem_deletedOwnerSubfiber_iff B T b).mp
      (by simpa only [E] using hbE)
    have hbOutside : (b : Fin n) ∉
        (Finset.univ : Finset (Fin d)).image leaf := by
      simpa only [← hL] using (Finset.mem_sdiff.mp (hTsub hbT)).2
    exact p.external_owner_eq_neg_one_of_mersenneLeaf
      g hg y root v B hd hv leaf hleaf e hnormal hcyclic b hbOutside k
        (hrows b hbT).1 (hrows b hbT).2.1
  have hweight : ∀ b, b ∈ E → p.weight b = 2 * k := by
    intro b hbE
    exact (hrows b ((mem_deletedOwnerSubfiber_iff B T b).mp
      (by simpa only [E] using hbE))).2.1
  have hEcapacity : E.card ≤ addOrderOf y - 1 :=
    p.card_fixedWeight_negOne_le_order_sub_one
      g hg y B E k howner hweight
  have hcharge :=
    completeExternalFiber_allAdjacentHeavy_or_card_le_omissionCharges_add_one_add_residualMatrices
      g hg y root v B p hyq hfullOdd hprimitive hd hv leaf hleaf e
        hnormal hcyclic r hrzero hdeleted hleafMem k₀ k hmiddle
          hprimaryWeight T (by simpa only [hL] using hTsub) hr hparameter
            (fun b hbT ↦ ⟨(hrows b hbT).1, (hrows b hbT).2.1⟩)
  refine ⟨T, hTcard, hTsub, ?_, ?_⟩
  · omega
  · simpa only [E] using hcharge

end MinModulus
