/-
# The actual odd-primary subgroup in the pure-star residual

The prime factor found arithmetically can be tied to the group element that
arose from the leaf recurrence.  Under no common touch this displacement is
nonzero.  Its additive order is therefore at least two, is odd, and divides
both the odd modulus factor and the Mersenne coefficient.  A prime divisor of
that actual order carries the bounded order-of-two certificate.
-/
import MinModulus.G1PrivateHeavyTargetPureStarLeafPrimeFactor

namespace MinModulus

open Finset

variable {m : ℕ}

/-- The nonzero leaf displacement generates an actual odd-order subgroup,
and `p` is a prime divisor of that subgroup's order. -/
structure MersenneTorsionPrimeCertificate
    {N : ℕ} (q ell p : ℕ) (y : ZMod N) : Prop where
  primeOrder : MersennePrimeOrderCertificate q ell p
  nonzero : y ≠ 0
  torsionOrderOdd : Odd (addOrderOf y)
  two_le_torsionOrder : 2 ≤ addOrderOf y
  torsionOrder_dvd_oddFactor : addOrderOf y ∣ q
  torsionOrder_dvd_mersenne : addOrderOf y ∣ 2 ^ ell - 1
  prime_dvd_torsionOrder : p ∣ addOrderOf y
  torsionOrder_le_oddFactor : addOrderOf y ≤ q
  torsionOrder_le_mersenne : addOrderOf y ≤ 2 ^ ell - 1

/-- A nonzero Mersenne-torsion element in `ZMod (2^t q)` generates an actual
nontrivial odd-order subgroup of the odd factor.  A prime divisor of that
order also has the corresponding bounded order-of-two certificate. -/
theorem exists_mersenneTorsionPrimeCertificate
    {t q ell : ℕ} [NeZero (2 ^ t * q)]
    (hell : 2 ≤ ell) (hq : q ≠ 0) (hodd : Odd (2 ^ ell - 1))
    {y : ZMod (2 ^ t * q)} (hy : y ≠ 0)
    (htorsion : (2 ^ ell - 1) • y = 0) :
    ∃ p : ℕ, MersenneTorsionPrimeCertificate q ell p y := by
  have hrM : addOrderOf y ∣ 2 ^ ell - 1 :=
    addOrderOf_dvd_of_nsmul_eq_zero htorsion
  have hrOdd : Odd (addOrderOf y) := Odd.of_dvd_nat hodd hrM
  have hrN : addOrderOf y ∣ 2 ^ t * q := by
    simpa only [Nat.card_zmod] using addOrderOf_dvd_natCard y
  have hrq : addOrderOf y ∣ q :=
    (hrOdd.coprime_two_right.pow_right t).dvd_of_dvd_mul_left hrN
  have hrPos : 0 < addOrderOf y := addOrderOf_pos y
  have hrNeOne : addOrderOf y ≠ 1 := by
    intro hr
    exact hy (AddMonoid.addOrderOf_eq_one_iff.mp hr)
  have hrTwo : 2 ≤ addOrderOf y := by omega
  obtain ⟨p, hp, hpr⟩ := Nat.exists_prime_and_dvd hrNeOne
  have hpq : p ∣ q := hpr.trans hrq
  have hpM : p ∣ 2 ^ ell - 1 := hpr.trans hrM
  have hpCert := mersennePrimeOrderCertificate_of_dvd
    hell hq hodd hp hpq hpM
  exact ⟨p, hpCert, hy, hrOdd, hrTwo, hrq, hrM, hpr,
    Nat.le_of_dvd (Nat.pos_of_ne_zero hq) hrq,
    Nat.le_of_dvd hodd.pos hrM⟩

/-- Pure-star endpoint in which the sole non-capacity branch identifies the
actual nonzero odd-primary subgroup generated by the leaf displacement. -/
def PureEdgeStarLeafOddPrimaryOutcome
    {t q : ℕ} (g : Fin (m + 1) → ZMod (2 ^ t * q))
    (h : ZMod (2 ^ t * q)) (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    (a : ↥(witnessPureEdgeStarLeaves g h r)) (d : ℕ)
    (center : Fin d → Fin (m + 1)) : Prop :=
  let leaf : Fin d → Fin (m + 1) :=
    fun j ↦ (T^[j.val] a : Fin (m + 1))
  2 * d + 1 ≤ m + 1 ∨
    (d + 2 ≤ m + 1 ∧
      ∃ j k ell : Fin d,
        center j = leaf k ∧ center ell ∉ Set.range leaf) ∨
    (PureEdgeStarLeafRelativeTorsionAlgebra g h r T a d center ∧
      ∃ i : Fin d, ∃ ell p : ℕ,
        2 ≤ ell ∧ ell ≤ d ∧
        (2 ^ ell - 1) • (g (leaf i) - (h + g r)) = 0 ∧
        MersenneTorsionPrimeCertificate q ell p
          (g (leaf i) - (h + g r)) ∧
        orderOf (2 : ZMod p) ≤ d)

/-- In the no-common-touch branch the retained torsion element cannot vanish:
vanishing would make the leaf and star differ by the distinguished
involution and invoke the established pair-difference deletion theorem. -/
theorem pureEdgeStarLeafCycle_oddPrimaryOutcome_of_primeFactorOutcome
    {t q : ℕ} [NeZero (2 ^ t * q)]
    (g : Fin (m + 1) → ZMod (2 ^ t * q)) (hg : ValidTuple g)
    {h : ZMod (2 ^ t * q)} (hh : h + h = 0) (hne : h ≠ 0)
    (hno : ¬ ∃ z : Fin (m + 1), ∀ c : Fin (m + 1) → ℤ,
      Witness g h c → c z ≠ 0)
    (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    {a : ↥(witnessPureEdgeStarLeaves g h r)} {d : ℕ}
    (center : Fin d → Fin (m + 1))
    (hout : PureEdgeStarLeafPrimeFactorOutcome
      g h r T a d center) :
    PureEdgeStarLeafOddPrimaryOutcome g h r T a d center := by
  have hq : q ≠ 0 := by
    intro hzero
    have hprod : 2 ^ t * q = 0 := by simp [hzero]
    exact NeZero.ne (2 ^ t * q) hprod
  rcases hout with hcap | hmixed |
      ⟨halg, i, ell, _p, hellTwo, hellD, htorsion, hprime, _hordD⟩
  · exact Or.inl hcap
  · exact Or.inr (Or.inl hmixed)
  · right
    right
    have hy :
        g (T^[i.val] a : Fin (m + 1)) - (h + g r) ≠ 0 := by
      intro hzero
      have hpair :
          g (T^[i.val] a : Fin (m + 1)) - g r = h := by
        have heq := sub_eq_zero.mp hzero
        rw [heq]
        abel
      exact hno ⟨r, common_touched_of_pair_difference g hg hh hne hpair⟩
    obtain ⟨p, htorsionPrime⟩ :=
      exists_mersenneTorsionPrimeCertificate
        hellTwo hq hprime.mersenneOdd hy htorsion
    exact ⟨halg, i, ell, p, hellTwo, hellD, htorsion, htorsionPrime,
      htorsionPrime.primeOrder.order_le_length.trans hellD⟩

/-- Global noncrossing cyclic endpoint with the actual nonzero odd-primary
leaf-displacement subgroup exposed in its sole non-capacity branch. -/
theorem exists_minimal_pureEdgeStarLeafCycle_oddPrimaryOutcome
    {t q : ℕ} [NeZero (2 ^ t * q)]
    (g : Fin (m + 1) → ZMod (2 ^ t * q)) (hg : ValidTuple g)
    {h : ZMod (2 ^ t * q)} (hh : h + h = 0) (hne : h ≠ 0)
    (hno : ¬ ∃ z : Fin (m + 1), ∀ c : Fin (m + 1) → ℤ,
      Witness g h c → c z ≠ 0)
    (r : Fin (m + 1))
    (qroot : ReducedSubsetSumCollision g h)
    (hqCanonical : qroot ∈ canonicalReducedCollisions (g := g) hh)
    (hcoeff : subsetCollisionCoeffs qroot.val.1 qroot.val.2 =
        supportAvoidingWitnessAt g hno r ∨
      subsetCollisionCoeffs qroot.val.1 qroot.val.2 =
        -supportAvoidingWitnessAt g hno r)
    (hthree : ¬ WitnessThreeDistinctOmissions g h)
    (hcross : ∀ q' : ReducedSubsetSumCollision g h,
      ¬ ((qroot, q') ∈ canonicalPositiveNegativeCrossPairs (g := g) hh ∨
        (q', qroot) ∈ canonicalPositiveNegativeCrossPairs (g := g) hh))
    (hL : (witnessPureEdgeStarLeaves g h r).Nonempty) :
    ∃ T : ↥(witnessPureEdgeStarLeaves g h r) →
        ↥(witnessPureEdgeStarLeaves g h r),
      ∃ a : ↥(witnessPureEdgeStarLeaves g h r), ∃ d : ℕ,
        ∃ center : Fin d → Fin (m + 1),
          d ≤ (witnessPureEdgeStarLeaves g h r).card ∧
          IsMinimalFixedPointFreeCycle T a d ∧
          Function.Injective center ∧
          (∀ j : Fin d,
            center j ≠ r ∧
            center j ≠ (T^[j.val] a : Fin (m + 1)) ∧
            center j ≠ (T (T^[j.val] a) : Fin (m + 1)) ∧
            (2 : ℤ) • g (center j) =
              h + g r + g (T (T^[j.val] a) : Fin (m + 1))) ∧
          PureEdgeStarLeafOddPrimaryOutcome g h r T a d center := by
  obtain ⟨T, a, d, center, hdCard, hcycle, hcenter, hcenterSpec, hout⟩ :=
    exists_minimal_pureEdgeStarLeafCycle_primeFactorOutcome
      g hg hh hne hno r qroot hqCanonical hcoeff hthree hcross hL
  have hout' :=
    pureEdgeStarLeafCycle_oddPrimaryOutcome_of_primeFactorOutcome
      g hg hh hne hno r T center hout
  exact ⟨T, a, d, center, hdCard, hcycle, hcenter, hcenterSpec, hout'⟩

end MinModulus
