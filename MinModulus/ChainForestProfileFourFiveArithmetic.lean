import MinModulus.ChainForestProfileIntegralCertificates

/-! Complete arithmetic certificates for companion lengths four and five.
All 840 nonintegral phases use complementary top shifts; all fourteen
integral phases use sparse boundaries with positive error cones. Finite
certificate checks use kernel reduction. The consumers produce actual
full-length representations and group rivals for every n >= 67. Deriving
these data from a genuine forest is a separate step. The unrestricted
conjecture remains open. -/

namespace MinModulus

structure FourFivePairPlan where
  κ : ℤ
  ν : ℤ
  mp : ℕ
  mm : ℕ
  Rp : ℕ
  Rm : ℕ
  ap : ℕ
  am : ℕ
  deriving DecidableEq

def FourFivePairCertificate (D F : ℕ) (P r : ℤ) (p : FourFivePairPlan) : Prop :=
  let S : ℤ := 61*F
  let W : ℤ := 64*F
  let J := p.κ*r-S*p.ν
  let Ap := S*(1-p.mp)+p.κ*P
  let Bp := S*(1-p.mp)-16*p.κ
  let Am := S*(1-p.mm)-p.κ*P
  let Bm := S*(1-p.mm)+16*p.κ
  (p.ap : ℤ)=D*p.κ+15*p.mp ∧
  (p.am : ℤ)=-(D : ℤ)*p.κ+15*p.mm ∧
  (p.ap ≠ 15 ∨ 31*p.mp ≠ 31) ∧
  (p.am ≠ 15 ∨ 31*p.mm ≠ 31) ∧
  (p.Rp : ℤ)=-p.κ*(P+W*r)+S*p.ν*W+S*p.mp ∧
  (p.Rm : ℤ)=p.κ*(P+W*r)-S*p.ν*W+S*p.mm ∧
  0 < p.Rp ∧ 0 < p.Rm ∧ p.Rp+p.Rm=(p.mp+p.mm)*(61*F) ∧
  0 < (p.Rp*4294967296)%(61*F) ∧
  (gmin 3 p.ap+gmin 4 (31*p.mp))+(gmin 3 p.am+gmin 4 (31*p.mm))+
    2*(p.mp+p.mm) ≤ 53 ∧
  -100000 < Ap-S+min J 0*(16*F) ∧ -100000 ≤ Bp ∧
  Ap+max J 0*(16*F) ≤ 100000 ∧ Bp ≤ 100000 ∧
  -100000 < Am-S+min (-J) 0*(16*F) ∧ -100000 ≤ Bm ∧
  Am+max (-J) 0*(16*F) ≤ 100000 ∧ Bm ≤ 100000

instance (D F : ℕ) (P r : ℤ) (p : FourFivePairPlan) :
    Decidable (FourFivePairCertificate D F P r p) := by
  unfold FourFivePairCertificate
  infer_instance

