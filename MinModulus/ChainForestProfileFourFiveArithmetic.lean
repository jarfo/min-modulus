/-- Every nonintegral four-five primitive phase has a kernel-checked
complementary plan, at each of the three possible indices. -/
theorem exists_four_five_nonintegral_pair_certificate
    {D F r : ℕ} {P : ℤ}
    (hcases : (D=2 ∧ F=4) ∨ (D=4 ∧ F=2) ∨ (D=8 ∧ F=1))
    (hr : (P=15 ∧ r < 61*F) ∨ (P = -47 ∧ 1 ≤ r ∧ r ≤ 61*F))
    (hnon : (P+(64*F : ℕ)*r)%61 ≠ 0) :
    ∃ p, FourFivePairCertificate D F P r p := by
  rcases hcases with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · rcases hr with ⟨rfl,hr⟩ | ⟨rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFivePair10_checked ⟨r,by omega⟩ (by omega) (by simpa using hnon)⟩
    · exact ⟨_,fourFivePair11_checked ⟨r,by omega⟩ (by change 0 < r; omega) (by simpa using hnon)⟩
  · rcases hr with ⟨rfl,hr⟩ | ⟨rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFivePair20_checked ⟨r,by omega⟩ (by omega) (by simpa using hnon)⟩
    · exact ⟨_,fourFivePair21_checked ⟨r,by omega⟩ (by change 0 < r; omega) (by simpa using hnon)⟩
  · rcases hr with ⟨rfl,hr⟩ | ⟨rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFivePair30_checked ⟨r,by omega⟩ (by omega) (by simpa using hnon)⟩
    · exact ⟨_,fourFivePair31_checked ⟨r,by omega⟩ (by change 0 < r; omega) (by simpa using hnon)⟩

/-- A 32-bit prefix leaves room for the uniformly certified errors. -/
theorem hundred_thousand_length_lt_two_pow_sub_forty_one
    {n : ℕ} (hn : 67 ≤ n) : 100000*n < 2^(n-41) := by
  induction n, hn using Nat.le_induction with
  | base => norm_num
  | succ n hn ih =>
    rw [show n+1-41=(n-41)+1 by omega,pow_succ]
    omega

/-- A checked complementary plan produces an actual affordable rival
for every length and every allowed height, drop and deficit. -/
theorem exists_four_five_rival_of_pair_certificate
    {n N L D F M E H c V α : ℕ} {P r : ℤ}
    (hn : 67 ≤ n) (hL : L+9=n) (hF : 1 ≤ F ∧ F ≤ 4)
    (hH : 1 ≤ H) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(64*F)*2^L) (hE : E ≤ (16*F)*H)
    (hphase : (61*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+16*c+r*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (htop : (2^L-1) • x+15 • a+31 • b=V • x) (hmx : M • x=0)
    (p : FourFivePairPlan) (hp : FourFivePairCertificate D F P r p) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 15 ∨ tb ≠ 31) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 3 ta+gmin 4 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  rcases hp with ⟨hap,ham,hnep,hnem,hRp,hRm,hRpp,hRmp,hRsum,hrem,hcost,
    hAp0,hBp0,hAp1,hBp1,hAm0,hBm0,hAm1,hBm1⟩
  let Zp : ℤ := -p.κ*α+p.ν*M+(p.mp : ℤ)*((2 : ℤ)^L-1-V)+V
  let Zm : ℤ := -(-p.κ)*α+(-p.ν)*M+(p.mm : ℤ)*((2 : ℤ)^L-1-V)+V
  have hwpos : (0 : ℤ) ≤ 100000 := by norm_num
  have hS : 0 < 61*F := by omega
  have hRp' : (p.Rp : ℤ)=-p.κ*(P+(64*F : ℕ)*r)+
      (61*F : ℕ)*p.ν*(64*F : ℕ)+(61*F : ℕ)*p.mp := by
    push_cast
    exact hRp
  have hRm' : (p.Rm : ℤ)=-(-p.κ)*(P+(64*F : ℕ)*r)+
      (61*F : ℕ)*(-p.ν)*(64*F : ℕ)+(61*F : ℕ)*p.mm := by
    push_cast
    nlinarith only [hRm]
  have hep := signed_axis_multiple_top_shift_error (t:=16) hbase hM (by simpa only [Nat.cast_pow,Nat.cast_ofNat] using hphase) hRp'
  have hem := signed_axis_multiple_top_shift_error (t:=16) hbase hM (by simpa only [Nat.cast_pow,Nat.cast_ofNat] using hphase) hRm'
  have hwp := signed_rival_linear_error_window
    (A := (61*F : ℕ)*(1-(p.mp : ℤ))+p.κ*P)
    (B := (61*F : ℕ)*(1-(p.mp : ℤ))-16*p.κ)
    (J := p.κ*r-(61*F : ℕ)*p.ν) hH hnc hE hS hwpos
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAp0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBp0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAp1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBp1)
  have hwm := signed_rival_linear_error_window
    (A := (61*F : ℕ)*(1-(p.mm : ℤ))-p.κ*P)
    (B := (61*F : ℕ)*(1-(p.mm : ℤ))+16*p.κ)
    (J := -(p.κ*r-(61*F : ℕ)*p.ν)) hH hnc hE hS hwpos
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAm0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBm0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hAm1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hBm1)
  have hwp' : (p.Rp : ℤ)*2^L < (61*F : ℕ)*Zp+(100000*n : ℕ) ∧
      (61*F : ℕ)*Zp < (p.Rp : ℤ)*2^L+(100000*n : ℕ) := by
    dsimp [Zp]
    push_cast at hep ⊢
    push_cast at hwp
    constructor <;> linarith only [hep,hwp.1,hwp.2]
  have hwm' : (p.Rm : ℤ)*2^L < (61*F : ℕ)*Zm+(100000*n : ℕ) ∧
      (61*F : ℕ)*Zm < (p.Rm : ℤ)*2^L+(100000*n : ℕ) := by
    dsimp [Zm]
    push_cast at hem ⊢
    push_cast at hwm
    constructor <;> linarith only [hem,hwm.1,hwm.2]
  have hsmall : 100000*n < 2^(L-32) := by
    rw [show L-32=n-41 by omega]
    exact hundred_thousand_length_lt_two_pow_sub_forty_one hn
  have hlarge : n ≤ 2^(L-32) := by omega
  have hh := exists_one_complementary_representation_of_combined_cost
    (n:=n) (L:=L) (e:=L-32) (w:=31) (d:=9) Zp Zm (by omega) hL
    hS (by norm_num; omega) hRpp hRmp hRsum hrem hcost hsmall hlarge hwp' hwm'
  rcases hh with ⟨hZ,hnZ,u,hu,hc⟩ | ⟨hZ,hnZ,u,hu,hc⟩
  · refine ⟨Zp.toNat,p.ap,31*p.mp,hnZ,hnep,u,hu,by omega,?_⟩
    exact signed_axis_multiple_top_shift_rival_eq Nat.one_le_two_pow x a b p.κ p.ν p.mp
      (by push_cast; nlinarith only [hap]) (by push_cast; ring) hα htop hmx (by simpa only [Zp,Zm,Nat.cast_pow,Nat.cast_ofNat] using hZ)
  · refine ⟨Zm.toNat,p.am,31*p.mm,hnZ,hnem,u,hu,by omega,?_⟩
    apply signed_axis_multiple_top_shift_rival_eq Nat.one_le_two_pow x a b (-p.κ) (-p.ν) p.mm
      (by push_cast; nlinarith only [ham]) (by push_cast; ring) hα htop hmx (by simpa only [Zp,Zm,Nat.cast_pow,Nat.cast_ofNat] using hZ)

structure FourFiveIntegralPlan where
  κ : ℤ
  ν : ℤ
  ta : ℕ
  tb : ℕ
  R : ℕ
  b : ℕ
  f : ℕ
  deriving DecidableEq

def FourFiveIntegralCertificate (D F : ℕ) (P Q r q : ℤ)
    (p : FourFiveIntegralPlan) : Prop :=
  let S : ℤ := 61*F
  let W : ℤ := 64*F
  let A := S-F*p.tb*Q+p.κ*P
  let B := S-3*F*p.tb-16*p.κ
  let J := S*p.ν-F*p.tb*q+p.κ*r
  (p.ta : ℤ)=p.tb+D*p.κ ∧ (p.ta ≠ 15 ∨ p.tb ≠ 31) ∧
  (p.R : ℤ)=F*p.tb*(Q+W*q)-p.κ*(P+W*r)-S*p.ν*W ∧
  (61*F)*p.b=2^p.f*p.R ∧ 1 ≤ p.b ∧ 1 ≤ p.f ∧ p.f ≤ 2 ∧
  gmin (p.f-1) p.b+gmin 3 p.ta+gmin 4 p.tb ≤ 40 ∧
  0 ≤ A+min J 0*(16*F) ∧ 0 ≤ B ∧ 0 < A+min J 0*(16*F)+B ∧
  A+max J 0*(16*F) ≤ 2000*(61*F) ∧ B ≤ 2000*(61*F)

instance (D F : ℕ) (P Q r q : ℤ) (p : FourFiveIntegralPlan) :
    Decidable (FourFiveIntegralCertificate D F P Q r q p) := by
  unfold FourFiveIntegralCertificate
  infer_instance

