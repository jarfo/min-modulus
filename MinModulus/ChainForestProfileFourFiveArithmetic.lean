/-- All fourteen integral four-five phases have sparse certificates;
the exact phase link determines their second primitive phase. -/
theorem exists_four_five_integral_certificate
    {D F r q : ℕ} {P Q : ℤ}
    (hcases : (D=2 ∧ F=4) ∨ (D=4 ∧ F=2) ∨ (D=8 ∧ F=1))
    (hr : (P=15 ∧ Q=1 ∧ r < 61*F) ∨ (P = -47 ∧ Q=5 ∧ 1 ≤ r ∧ r ≤ 61*F))
    (hq : q < 61) (hlink : (4*r+q)%61=0)
    (hint : (P+(64*F : ℕ)*r)%61=0) :
    ∃ p, FourFiveIntegralCertificate D F P Q r q p := by
  rcases hcases with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · rcases hr with ⟨rfl,rfl,hr⟩ | ⟨rfl,rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFiveIntegral10_checked ⟨r,by omega⟩ (by change r < _; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩
    · exact ⟨_,fourFiveIntegral11_checked ⟨r,by omega⟩ (by change 0 < r; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩
  · rcases hr with ⟨rfl,rfl,hr⟩ | ⟨rfl,rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFiveIntegral20_checked ⟨r,by omega⟩ (by change r < _; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩
    · exact ⟨_,fourFiveIntegral21_checked ⟨r,by omega⟩ (by change 0 < r; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩
  · rcases hr with ⟨rfl,rfl,hr⟩ | ⟨rfl,rfl,hrlo,hrhi⟩
    · exact ⟨_,fourFiveIntegral30_checked ⟨r,by omega⟩ (by change r < _; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩
    · exact ⟨_,fourFiveIntegral31_checked ⟨r,by omega⟩ (by change 0 < r; omega)
        (by simpa using hint) ⟨q,hq⟩ hlink⟩

/-- A checked integral plan gives an actual sparse rival uniformly in
length, without requiring the period coprime to the primitive denominator. -/
theorem exists_four_five_rival_of_integral_certificate
    {n N L D F M E H c V α z : ℕ} {P Q r q : ℤ}
    (hn : 67 ≤ n) (hL : L+9=n) (hF : 1 ≤ F)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(64*F)*2^L) (hE : E ≤ (16*F)*H)
    (hphase : (61*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+16*c+r*M)
    (hzphase : 61*(z : ℤ)=Q*(2 : ℤ)^L+(61-Q)*H+58*c-61+q*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (hz : z • x+a+b=V • x) (hmx : M • x=0)
    (p : FourFiveIntegralPlan) (hp : FourFiveIntegralCertificate D F P Q r q p) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 15 ∨ tb ≠ 31) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 3 ta+gmin 4 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  rcases hp with ⟨hta,hne,hR,hb,hbp,hflo,hfhi,hcost,hA0,hB0,hpos,hA1,hB1⟩
  let Z : ℤ := (p.tb : ℤ)*z-p.κ*α+(1-(p.tb : ℤ))*V-p.ν*M
  have hS : 0 < 61*F := by omega
  have hbaseZ : (H : ℤ)+c=V+1 := by exact_mod_cast hbase
  have hMZ : (M : ℤ)+E=(64*F : ℕ)*(2 : ℤ)^L := by exact_mod_cast hM
  have herr : (61*F : ℕ)*Z-(p.R : ℤ)*2^L =
      ((61*F : ℕ)-(F : ℤ)*p.tb*Q+p.κ*P)*H+
      ((61*F : ℕ)-3*(F : ℤ)*p.tb-16*p.κ)*c-(61*F : ℕ)+
      ((61*F : ℕ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*E := by
    dsimp [Z]
    push_cast at hphase hMZ ⊢
    linear_combination (F : ℤ)*p.tb*hzphase-p.κ*hphase-
      (61*(F : ℤ))*(1-(p.tb : ℤ))*hbaseZ-
      (61*(F : ℤ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*hMZ-hR*(2 : ℤ)^L
  have he : L-p.f+(p.f-1+1)=L := by omega
  have hpow : 2^L=2^p.f*2^(L-p.f) := by
    rw [← pow_add,show p.f+(L-p.f)=L by omega]
  have hboundaryeq : (61*F : ℕ)*(p.b*2^(L-p.f) : ℕ)=(p.R : ℤ)*2^L := by
    have hh : (61*F)*(p.b*2^(L-p.f))=p.R*2^L := by
      rw [← Nat.mul_assoc,hb,hpow]
      ring
    exact_mod_cast hh
  have htail := two_thousand_length_lt_two_pow_sub_forty hn
  have hboundary : n ≤ p.b*2^(L-p.f) := by
    have hh := Nat.pow_le_pow_right (by decide : 0 < 2) (show n-40 ≤ L-p.f by omega)
    have hh' := Nat.mul_le_mul_right (2^(L-p.f)) hbp
    omega
  have hsmall : (2000*(61*F))*n ≤ (61*F)*2^(n-40) := by
    have hh := Nat.mul_le_mul_left (61*F) (le_of_lt htail)
    nlinarith only [hh]
  have hcost' : gmin (p.f-1) p.b+(n-40)+(gmin 3 p.ta+gmin 4 p.tb) ≤ n := by omega
  have herr' : (61*F : ℕ)*(Z-(p.b*2^(L-p.f) : ℕ))=
      ((61*F : ℕ)-(F : ℤ)*p.tb*Q+p.κ*P)*H+
      ((61*F : ℕ)-3*(F : ℤ)*p.tb-16*p.κ)*c-(61*F : ℕ)+
      ((61*F : ℕ)*p.ν-(F : ℤ)*p.tb*q+p.κ*r)*E := by
    linear_combination herr-hboundaryeq
  obtain ⟨hZ,hnZ,u,hu,hcu⟩ := exists_rep_of_integral_rival_error_certificate
    (L:=L) (w:=p.f-1) (e:=L-p.f) (k:=n-40) Z he (by omega) hS hboundary hcost' hsmall
    hH hc hnc hE
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hA0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hB0)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hpos)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hA1)
    (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using hB1) herr'
  refine ⟨Z.toNat,p.ta,p.tb,hnZ,hne,u,hu,by omega,?_⟩
  exact signed_axis_basis_rival_eq x a b p.κ p.ν hta hz hα hmx hZ

/-- Every bounded four-five primitive phase gives an actual affordable
rival. This covers all 854 phases, including the fourteen integral ones. -/
theorem exists_four_five_primitive_rival
    {n N L D F M E H c V α z r q : ℕ} {P Q : ℤ}
    (hn : 67 ≤ n) (hL : L+9=n)
    (hcases : (D=2 ∧ F=4) ∨ (D=4 ∧ F=2) ∨ (D=8 ∧ F=1))
    (hr : (P=15 ∧ Q=1 ∧ r < 61*F) ∨ (P = -47 ∧ Q=5 ∧ 1 ≤ r ∧ r ≤ 61*F))
    (hq : q < 61) (hlink : (4*r+q)%61=0)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=(64*F)*2^L) (hE : E ≤ (16*F)*H)
    (hphase : (61*F : ℕ)*(α : ℤ)=P*((2 : ℤ)^L-H)+16*c+(r : ℤ)*M)
    (hzphase : 61*(z : ℤ)=Q*(2 : ℤ)^L+(61-Q)*H+58*c-61+(q : ℤ)*M)
    (x a b : ZMod N) (hα : α • x=D • a)
    (htop : (2^L-1) • x+15 • a+31 • b=V • x)
    (hz : z • x+a+b=V • x) (hmx : M • x=0) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 15 ∨ tb ≠ 31) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 3 ta+gmin 4 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  have hF : 1 ≤ F ∧ F ≤ 4 := by rcases hcases with h | h | h <;> omega
  by_cases hint : (P+(64*F : ℕ)*r)%61=0
  · obtain ⟨p,hp⟩ := exists_four_five_integral_certificate hcases hr hq hlink hint
    exact exists_four_five_rival_of_integral_certificate hn hL hF.1 hH hc hnc hbase
      hM hE hphase hzphase x a b hα hz hmx p hp
  · have hr' : (P=15 ∧ r < 61*F) ∨ (P = -47 ∧ 1 ≤ r ∧ r ≤ 61*F) := by
      rcases hr with ⟨hP,_,hr⟩ | ⟨hP,_,hlo,hhi⟩
      · exact Or.inl ⟨hP,hr⟩
      · exact Or.inr ⟨hP,hlo,hhi⟩
    obtain ⟨p,hp⟩ := exists_four_five_nonintegral_pair_certificate hcases hr' hint
    exact exists_four_five_rival_of_pair_certificate hn hL hF hH hnc hbase
      hM hE hphase x a b hα htop hmx p hp

end MinModulus
