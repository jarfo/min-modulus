/-
# Fixed-cardinality layer bounds for the odd-primary doubling cycle

Validity forbids two distinct equal-cardinality coordinate sets from having
the same subset sum.  Consequently, if `ell` distinct translated tuple
coordinates lie in one cyclic subgroup, every `k`-th subset layer embeds in
that subgroup and

    Nat.choose ell k <= addOrderOf y.

Applied to a least relative-permutation cycle, the recurrence
`y (R i) = 2 • y i` puts the whole component in the subgroup generated by
its first displacement.  This supplies an exponential lower bound (at the
middle layer) for the actual odd-primary kernel order, complementing the
existing Mersenne upper bound.
-/
import MinModulus.G1OddPrimarySingletonComplement

namespace MinModulus

open Finset

variable {n : ℕ} {G : Type*} [AddCommGroup G]

/-- Distinct equal-cardinality sets of distinct tuple coordinates have
distinct subset sums. -/
theorem validTuple_subsetSum_eq_of_card_eq
    (g : Fin n → G) (hg : ValidTuple g)
    {α : Type*} [DecidableEq α]
    (e : α ↪ Fin n) {S T : Finset α}
    (hcard : S.card = T.card)
    (hsum : (∑ i ∈ S, g (e i)) = ∑ i ∈ T, g (e i)) :
    S = T := by
  classical
  let c : Fin n → ℤ := fun i ↦
    (if i ∈ S.map e then (1 : ℤ) else 0) -
      (if i ∈ T.map e then (1 : ℤ) else 0)
  by_contra hne
  have hmapne : S.map e ≠ T.map e := by
    intro h
    exact hne (Finset.map_injective e h)
  have hcne : c ≠ 0 := by
    intro hc
    apply hmapne
    ext i
    have hi := congrFun hc i
    simp only [c, Pi.zero_apply] at hi
    by_cases hiS : i ∈ S.map e <;> by_cases hiT : i ∈ T.map e <;>
      simp [hiS, hiT] at hi ⊢
  apply (validTuple_iff_no_zero_witness g).mp hg c
  refine ⟨hcne, ?_, ?_, ?_⟩
  · intro i
    dsimp [c]
    split_ifs <;> omega
  · dsimp [c]
    rw [Finset.sum_sub_distrib]
    simp only [Finset.sum_ite_mem, Finset.univ_inter,
      Finset.sum_const, nsmul_eq_mul, mul_one]
    rw [Finset.card_map, Finset.card_map, hcard, sub_self]
  · dsimp [c]
    simp_rw [sub_smul]
    rw [Finset.sum_sub_distrib]
    simp_rw [ite_smul, one_zsmul, zero_zsmul]
    simp only [Finset.sum_ite_mem, Finset.univ_inter]
    rw [Finset.sum_map, Finset.sum_map]
    exact sub_eq_zero.mpr hsum

/-- If `ell` distinct translated tuple coordinates lie in `zmultiples y`,
then every fixed-cardinality subset layer embeds in that cyclic subgroup. -/
theorem choose_le_addOrderOf_of_translated_coordinates_mem_zmultiples
    [Fintype G]
    (g : Fin n → G) (hg : ValidTuple g)
    {ell : ℕ} (e : Fin ell ↪ Fin n) (a y : G)
    (hmem : ∀ j, g (e j) - a ∈ AddSubgroup.zmultiples y)
    (k : ℕ) :
    ell.choose k ≤ addOrderOf y := by
  classical
  let L := (Finset.univ : Finset (Fin ell)).powersetCard k
  let encode : ↥L → AddSubgroup.zmultiples y := fun S ↦
    ⟨∑ j ∈ S.1, (g (e j) - a),
      AddSubgroup.sum_mem _ fun j _ ↦ hmem j⟩
  have hencode : Function.Injective encode := by
    intro S T hST
    apply Subtype.ext
    apply validTuple_subsetSum_eq_of_card_eq g hg e
    · have hScard := (Finset.mem_powersetCard.mp S.property).2
      have hTcard := (Finset.mem_powersetCard.mp T.property).2
      omega
    · have hval := congrArg Subtype.val hST
      dsimp [encode] at hval
      simp_rw [Finset.sum_sub_distrib, Finset.sum_const] at hval
      have hScard := (Finset.mem_powersetCard.mp S.property).2
      have hTcard := (Finset.mem_powersetCard.mp T.property).2
      rw [hScard, hTcard] at hval
      exact sub_left_inj.mp hval
  have hcard := Fintype.card_le_of_injective encode hencode
  rw [Fintype.card_coe, Finset.card_powersetCard,
    Finset.card_univ, Fintype.card_fin,
    ← Nat.card_eq_fintype_card, Nat.card_zmultiples] at hcard
  exact hcard

/-- A least cycle of a doubling recurrence consists entirely of translates
inside the cyclic subgroup generated by its initial displacement. -/
theorem doubling_minimalCycle_translated_mem_zmultiples
    {α : Type*} (R : α → α) (x : α → G) (a : G)
    (hx : ∀ i, x (R i) - a = 2 • (x i - a))
    {i : α} {ell : ℕ} :
    ∀ j : Fin ell,
      x (R^[j.val] i) - a ∈ AddSubgroup.zmultiples (x i - a) := by
  intro j
  rw [AddSubgroup.mem_zmultiples_iff]
  refine ⟨(2 ^ j.val : ℕ), ?_⟩
  norm_cast
  have hrec : ∀ u, (fun v ↦ x v - a) (R u) = 2 • (fun v ↦ x v - a) u := hx
  simpa using
    (apply_iterate_eq_pow_two_nsmul_of_apply_eq_two_nsmul
      R (fun v ↦ x v - a) hrec j.val i).symm

/-- A minimal component of a doubling recurrence on distinct tuple
coordinates has all binomial layers bounded by the additive order of its
initial displacement. -/
theorem choose_le_addOrderOf_of_minimal_doublingCycle
    [Fintype G]
    (g : Fin n → G) (hg : ValidTuple g)
    {d : ℕ} (leaf : Fin d ↪ Fin n)
    (R : Equiv.Perm (Fin d)) (x : Fin d → G) (a : G)
    (hx : ∀ j, x j = g (leaf j))
    (hrec : ∀ j, x (R j) - a = 2 • (x j - a))
    {i : Fin d} {ell : ℕ}
    (hcycle : IsMinimalFixedPointFreeCycle R i ell)
    (k : ℕ) :
    ell.choose k ≤ addOrderOf (x i - a) := by
  let orbit : Fin ell ↪ Fin d :=
    ⟨fun j ↦ R^[j.val] i,
      minimalFixedPointFreeCycle_iterates_injective R hcycle⟩
  let coords : Fin ell ↪ Fin n :=
    ⟨fun j ↦ leaf (orbit j), leaf.injective.comp orbit.injective⟩
  apply choose_le_addOrderOf_of_translated_coordinates_mem_zmultiples
    g hg coords a (x i - a)
  intro j
  change g (leaf (R^[j.val] i)) - a ∈
    AddSubgroup.zmultiples (x i - a)
  rw [← hx]
  exact doubling_minimalCycle_translated_mem_zmultiples R x a hrec j

/-- The relative permutation has a least component whose Mersenne torsion
and every fixed-cardinality subgroup lower bound hold simultaneously. -/
theorem exists_minimal_relativePermCycle_oddTorsion_layerBounds
    [Fintype G]
    (g : Fin n → G) (hg : ValidTuple g)
    {d : ℕ} (leaf : Fin d ↪ Fin n) (a : G)
    (P S : Equiv.Perm (Fin d))
    (hd : 2 ≤ d)
    (hne : ∀ j, P j ≠ S j)
    (hrel : ∀ j, (2 : ℤ) • g (leaf (P j)) =
      a + g (leaf (S j))) :
    ∃ i : Fin d, ∃ ell : ℕ,
      ell ≤ d ∧
      IsMinimalFixedPointFreeCycle (P.symm.trans S) i ell ∧
      Odd (2 ^ ell - 1) ∧
      (2 ^ ell - 1) • (g (leaf i) - a) = 0 ∧
      ∀ k : ℕ, ell.choose k ≤ addOrderOf (g (leaf i) - a) := by
  let R : Equiv.Perm (Fin d) := P.symm.trans S
  have hRne : ∀ i, R i ≠ i :=
    perm_symm_trans_fixedPointFree_of_apply_ne P S hne
  obtain ⟨i, D, hDtwo, hDd, hDperiod⟩ :=
    exists_bounded_cycle_of_fixedPointFree R ⟨0, by omega⟩ hRne
  obtain ⟨ell, hellD, hcycle⟩ :=
    exists_minimalFixedPointFreeCycle_of_period R i hRne
      (by omega : 0 < D) hDperiod
  let x : Fin d → G := fun j ↦ g (leaf j)
  have hRrel : ∀ j, (2 : ℤ) • x j = a + x (R j) := by
    intro j
    simpa [R, x] using hrel (P.symm j)
  have hrec : ∀ j, x (R j) - a = 2 • (x j - a) := by
    intro j
    have hj := hRrel j
    rw [two_zsmul] at hj
    rw [two_nsmul]
    calc
      x (R j) - a = (a + x (R j)) - (a + a) := by abel
      _ = (x j + x j) - (a + a) := by rw [← hj]
      _ = (x j - a) + (x j - a) := by abel
  have htorsion : (2 ^ ell - 1) • (g (leaf i) - a) = 0 := by
    simpa [x] using pow_two_sub_one_nsmul_eq_zero_of_iterate_eq
      R (fun j ↦ x j - a) hrec hcycle.2.1
  have hellPos : 0 < ell := lt_of_lt_of_le (by decide) hcycle.1
  have hellDecomp : ell = (ell - 1) + 1 := by omega
  have hpowEq : 2 ^ ell = 2 * 2 ^ (ell - 1) := by
    calc
      2 ^ ell = 2 ^ ((ell - 1) + 1) := by rw [← hellDecomp]
      _ = 2 * 2 ^ (ell - 1) := by rw [pow_succ, mul_comm]
  have hodd : Odd (2 ^ ell - 1) := by
    refine ⟨2 ^ (ell - 1) - 1, ?_⟩
    rw [hpowEq]
    have hpowPos : 1 ≤ 2 ^ (ell - 1) := by
      exact Nat.one_le_two_pow
    omega
  have hDd' : D ≤ d := by simpa using hDd
  refine ⟨i, ell, hellD.trans hDd', hcycle, hodd, htorsion, ?_⟩
  intro k
  exact choose_le_addOrderOf_of_minimal_doublingCycle
    g hg leaf R x a (fun _ ↦ rfl) hrec hcycle k

variable {m : ℕ}

/-- Saturated pure-star algebra together with a least relative component and
all of its binomial-layer lower bounds in the actual cyclic subgroup. -/
def PureEdgeStarLeafCycleLayerAlgebra
    (g : Fin (m + 1) → G) (h : G) (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    (a : ↥(witnessPureEdgeStarLeaves g h r)) (d : ℕ)
    (center : Fin d → Fin (m + 1)) : Prop :=
  let leaf : Fin d → Fin (m + 1) :=
    fun j ↦ (T^[j.val] a : Fin (m + 1))
  PureEdgeStarLeafPermutationAlgebra g h r T a d center ∧
    ∃ i : Fin d, ∃ ell : ℕ,
      2 ≤ ell ∧ ell ≤ d ∧ Odd (2 ^ ell - 1) ∧
      (2 ^ ell - 1) • (g (leaf i) - (h + g r)) = 0 ∧
      ∀ k : ℕ,
        ell.choose k ≤ addOrderOf (g (leaf i) - (h + g r))

/-- Every saturated pure-star permutation algebra over a valid tuple carries
the fixed-layer subgroup bounds on a least relative component. -/
theorem PureEdgeStarLeafPermutationAlgebra.cycleLayerBounds
    [Fintype G]
    (g : Fin (m + 1) → G) (hg : ValidTuple g) {h : G}
    (r : Fin (m + 1))
    (T : ↥(witnessPureEdgeStarLeaves g h r) →
      ↥(witnessPureEdgeStarLeaves g h r))
    {a : ↥(witnessPureEdgeStarLeaves g h r)} {d : ℕ}
    (center : Fin d → Fin (m + 1))
    (hcycle : IsMinimalFixedPointFreeCycle T a d)
    (halg : PureEdgeStarLeafPermutationAlgebra g h r T a d center) :
    PureEdgeStarLeafCycleLayerAlgebra g h r T a d center := by
  let leafFun : Fin d → Fin (m + 1) :=
    fun j ↦ (T^[j.val] a : Fin (m + 1))
  have hleaf : Function.Injective leafFun := by
    intro j k hjk
    apply minimalFixedPointFreeCycle_iterates_injective T hcycle
    exact Subtype.ext hjk
  let leaf : Fin d ↪ Fin (m + 1) := ⟨leafFun, hleaf⟩
  have halg' := halg
  obtain ⟨P, S, hlocal, _hsum⟩ := halg'
  obtain ⟨i, ell, hellD, hrelativeCycle, hodd, htorsion, hlayers⟩ :=
    exists_minimal_relativePermCycle_oddTorsion_layerBounds
      g hg leaf (h + g r) P S hcycle.1
        (fun j ↦ (hlocal j).2.1)
        (fun j ↦ by simpa [leaf, leafFun] using (hlocal j).2.2.2.2)
  refine ⟨halg, i, ell, hrelativeCycle.1, hellD, hodd, ?_, ?_⟩
  · simpa [leaf, leafFun] using htorsion
  · intro k
    simpa [leaf, leafFun] using hlayers k

end MinModulus
