/-
# Corrected-subset collisions in the primitive exact-two window

For a corrected row

    h_b = g_b - g_z + k_b (g_x - g_z),

a collision between two subset sums gives a zero relation on the two owner
subsets and the retained coordinates.  Its retained coefficients are the
differences of the two profile coordinates

    K(A) = sum_{b in A} k_b,
    L(A) = -|A| - K(A).

Validity says that neither orientation of a nontrivial collision may have
both retained coefficients at least `-1`.  Hence every collision reverses
the two profile orders, with gaps at least two.  This is the exact obstruction
which any packing argument for the three-residue window must exploit.
-/
import MinModulus.G1OddPrimaryFullCyclePrimitiveWindow

namespace MinModulus

open Finset

variable {n : ℕ} {G : Type*} [AddCommGroup G]

/-- The kernel-valued correction of one deleted owner. -/
def correctedOwnerValue (g : Fin n → G) (x z : Fin n)
    {B : Finset (Fin n)} (k : ↥B → ℤ) (b : ↥B) : G :=
  g (b : Fin n) - g z + k b • (g x - g z)

/-- The coefficient of `g x` in a corrected subset sum. -/
def correctedSubsetXCoefficient {B : Finset (Fin n)}
    (k : ↥B → ℤ) (A : Finset ↥B) : ℤ :=
  ∑ b ∈ A, k b

/-- The coefficient of `g z` in a corrected subset sum. -/
def correctedSubsetZCoefficient {B : Finset (Fin n)}
    (k : ↥B → ℤ) (A : Finset ↥B) : ℤ :=
  -(A.card : ℤ) - correctedSubsetXCoefficient k A

/-- Exact affine expansion of a corrected subset sum. -/
theorem sum_correctedOwnerValue
    (g : Fin n → G) (x z : Fin n) {B : Finset (Fin n)}
    (k : ↥B → ℤ) (A : Finset ↥B) :
    (∑ b ∈ A, correctedOwnerValue g x z k b) =
      (∑ b ∈ A, g (b : Fin n)) +
        correctedSubsetXCoefficient k A • g x +
        correctedSubsetZCoefficient k A • g z := by
  simp only [correctedOwnerValue, correctedSubsetXCoefficient,
    correctedSubsetZCoefficient, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Finset.sum_const, zsmul_sub,
    ← Finset.sum_smul]
  module

/-- The owner coordinates underlying a subset of a deletion set. -/
def correctedSubsetOwnerSet {B : Finset (Fin n)}
    (A : Finset ↥B) : Finset (Fin n) :=
  Finset.image (fun b : ↥B ↦ (b : Fin n)) A

/-- Coefficient vector of the zero relation generated by a corrected-subset
collision. -/
def correctedSubsetRelationCoeffs (x z : Fin n)
    {B : Finset (Fin n)} (k : ↥B → ℤ)
    (A C : Finset ↥B) : Fin n → ℤ := fun i ↦
  (if i ∈ correctedSubsetOwnerSet A then 1 else 0) -
    (if i ∈ correctedSubsetOwnerSet C then 1 else 0) +
    (if i = x then
      correctedSubsetXCoefficient k A - correctedSubsetXCoefficient k C
    else 0) +
    (if i = z then
      correctedSubsetZCoefficient k A - correctedSubsetZCoefficient k C
    else 0)

/-- A nontrivial corrected-subset collision cannot have both retained
coefficient differences at least `-1`.  Such a collision would itself be a
zero witness forbidden by validity. -/
theorem not_both_retained_gaps_ge_neg_one_of_correctedSubsetSum_eq
    (g : Fin n → G) (hg : ValidTuple g)
    (x z : Fin n) {B : Finset (Fin n)}
    (hxB : x ∉ B) (hzB : z ∉ B) (hxz : x ≠ z)
    (k : ↥B → ℤ) (A C : Finset ↥B) (hAC : A ≠ C)
    (hsum : (∑ b ∈ A, correctedOwnerValue g x z k b) =
      ∑ b ∈ C, correctedOwnerValue g x z k b) :
    ¬(-1 ≤ correctedSubsetXCoefficient k A -
          correctedSubsetXCoefficient k C ∧
        -1 ≤ correctedSubsetZCoefficient k A -
          correctedSubsetZCoefficient k C) := by
  classical
  intro hgaps
  let AI : Finset (Fin n) := correctedSubsetOwnerSet A
  let CI : Finset (Fin n) := correctedSubsetOwnerSet C
  let u : ℤ := correctedSubsetXCoefficient k A -
    correctedSubsetXCoefficient k C
  let v : ℤ := correctedSubsetZCoefficient k A -
    correctedSubsetZCoefficient k C
  let c : Fin n → ℤ := correctedSubsetRelationCoeffs x z k A C
  have hxAI : x ∉ AI := by
    intro hx
    obtain ⟨b, _hbA, hbx⟩ := Finset.mem_image.mp hx
    exact hxB (hbx ▸ b.property)
  have hxCI : x ∉ CI := by
    intro hx
    obtain ⟨b, _hbC, hbx⟩ := Finset.mem_image.mp hx
    exact hxB (hbx ▸ b.property)
  have hzAI : z ∉ AI := by
    intro hz
    obtain ⟨b, _hbA, hbz⟩ := Finset.mem_image.mp hz
    exact hzB (hbz ▸ b.property)
  have hzCI : z ∉ CI := by
    intro hz
    obtain ⟨b, _hbC, hbz⟩ := Finset.mem_image.mp hz
    exact hzB (hbz ▸ b.property)
  have hcNe : c ≠ 0 := by
    intro hc
    apply hAC
    ext b
    have hbx : (b : Fin n) ≠ x := fun h ↦ hxB (h ▸ b.property)
    have hbz : (b : Fin n) ≠ z := fun h ↦ hzB (h ▸ b.property)
    have hcb := congrFun hc (b : Fin n)
    simp only [c, correctedSubsetRelationCoeffs, hbx, hbz,
      if_false, add_zero, Pi.zero_apply] at hcb
    have hbAI : (b : Fin n) ∈ AI ↔ b ∈ A := by
      simp only [AI, correctedSubsetOwnerSet, Finset.mem_image]
      constructor
      · rintro ⟨a, ha, hab⟩
        simpa [Subtype.ext hab] using ha
      · intro hb
        exact ⟨b, hb, rfl⟩
    have hbCI : (b : Fin n) ∈ CI ↔ b ∈ C := by
      simp only [CI, correctedSubsetOwnerSet, Finset.mem_image]
      constructor
      · rintro ⟨a, ha, hab⟩
        simpa [Subtype.ext hab] using ha
      · intro hb
        exact ⟨b, hb, rfl⟩
    by_cases hbA : b ∈ A <;> by_cases hbC : b ∈ C
    · exact iff_of_true hbA hbC
    · have hbAI' : (b : Fin n) ∈ AI := hbAI.mpr hbA
      have hbCI' : (b : Fin n) ∉ CI := fun hb ↦ hbC (hbCI.mp hb)
      change ((if (b : Fin n) ∈ AI then 1 else 0) -
        (if (b : Fin n) ∈ CI then 1 else 0)) = 0 at hcb
      rw [if_pos hbAI', if_neg hbCI'] at hcb
      norm_num at hcb
    · have hbAI' : (b : Fin n) ∉ AI := fun hb ↦ hbA (hbAI.mp hb)
      have hbCI' : (b : Fin n) ∈ CI := hbCI.mpr hbC
      change ((if (b : Fin n) ∈ AI then 1 else 0) -
        (if (b : Fin n) ∈ CI then 1 else 0)) = 0 at hcb
      rw [if_neg hbAI', if_pos hbCI'] at hcb
      norm_num at hcb
    · exact iff_of_false hbA hbC
  have hcFloor : ∀ i, -1 ≤ c i := by
    intro i
    by_cases hix : i = x
    · subst i
      simpa only [c, correctedSubsetRelationCoeffs, AI, CI, hxAI, hxCI,
        if_false, if_pos, hxz, add_zero, sub_zero, zero_add] using hgaps.1
    · by_cases hiz : i = z
      · subst i
        simp only [c, correctedSubsetRelationCoeffs, AI, CI, hzAI, hzCI,
          if_false, if_pos, hix, add_zero, zero_add, sub_zero]
        exact hgaps.2
      · simp only [c, correctedSubsetRelationCoeffs, hix, hiz, if_false,
          add_zero]
        split_ifs <;> omega
  have hcSum : (∑ i, c i) = 0 := by
    have hAIcard : AI.card = A.card := by
      simpa only [AI, correctedSubsetOwnerSet] using
        Finset.card_image_of_injective A Subtype.coe_injective
    have hCIcard : CI.card = C.card := by
      simpa only [CI, correctedSubsetOwnerSet] using
        Finset.card_image_of_injective C Subtype.coe_injective
    simp only [c, correctedSubsetRelationCoeffs,
      Finset.sum_add_distrib, Finset.sum_sub_distrib]
    rw [show correctedSubsetOwnerSet A = AI by rfl,
      show correctedSubsetOwnerSet C = CI by rfl]
    simp only [Finset.sum_boole, Finset.filter_mem_eq_inter]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true]
    simp only [Finset.univ_inter]
    rw [hAIcard, hCIcard]
    simp only [correctedSubsetZCoefficient]
    omega
  have hrelation :
      ((∑ b ∈ A, g (b : Fin n)) - ∑ b ∈ C, g (b : Fin n)) +
          u • g x + v • g z = 0 := by
    rw [sum_correctedOwnerValue, sum_correctedOwnerValue] at hsum
    have hzero := sub_eq_zero.mpr hsum
    (convert hzero using 1; module)
  have hcValue : (∑ i, c i • g i) = 0 := by
    have hAISum :
        (∑ i, (if i ∈ AI then (1 : ℤ) else 0) • g i) =
          ∑ b ∈ A, g (b : Fin n) := by
      calc
        (∑ i, (if i ∈ AI then (1 : ℤ) else 0) • g i) =
            ∑ i ∈ AI, g i := by simp
        _ = ∑ b ∈ A, g (b : Fin n) := by
          simpa only [AI, correctedSubsetOwnerSet] using
            (Finset.sum_image (f := g)
              (s := A) Subtype.coe_injective.injOn)
    have hCISum :
        (∑ i, (if i ∈ CI then (1 : ℤ) else 0) • g i) =
          ∑ b ∈ C, g (b : Fin n) := by
      calc
        (∑ i, (if i ∈ CI then (1 : ℤ) else 0) • g i) =
            ∑ i ∈ CI, g i := by simp
        _ = ∑ b ∈ C, g (b : Fin n) := by
          simpa only [CI, correctedSubsetOwnerSet] using
            (Finset.sum_image (f := g)
              (s := C) Subtype.coe_injective.injOn)
    simp only [c, correctedSubsetRelationCoeffs, sub_smul, add_smul,
      Finset.sum_add_distrib, Finset.sum_sub_distrib]
    rw [show correctedSubsetOwnerSet A = AI by rfl,
      show correctedSubsetOwnerSet C = CI by rfl, hAISum, hCISum]
    simp only [ite_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true]
    exact hrelation
  exact (validTuple_iff_no_zero_witness g).mp hg c
    ⟨hcNe, hcFloor, hcSum, hcValue⟩

/-- Exact two-sided collision obstruction: distinct subsets with the same
corrected sum must reverse the `X` and `Z` profile orders, and both gaps have
absolute size at least two. -/
theorem correctedSubsetSum_eq_forces_crossing_retained_gaps
    (g : Fin n → G) (hg : ValidTuple g)
    (x z : Fin n) {B : Finset (Fin n)}
    (hxB : x ∉ B) (hzB : z ∉ B) (hxz : x ≠ z)
    (k : ↥B → ℤ) (A C : Finset ↥B) (hAC : A ≠ C)
    (hsum : (∑ b ∈ A, correctedOwnerValue g x z k b) =
      ∑ b ∈ C, correctedOwnerValue g x z k b) :
    ¬(-1 ≤ correctedSubsetXCoefficient k A -
          correctedSubsetXCoefficient k C ∧
        -1 ≤ correctedSubsetZCoefficient k A -
          correctedSubsetZCoefficient k C) ∧
      ¬(correctedSubsetXCoefficient k A -
            correctedSubsetXCoefficient k C ≤ 1 ∧
          correctedSubsetZCoefficient k A -
            correctedSubsetZCoefficient k C ≤ 1) := by
  refine ⟨not_both_retained_gaps_ge_neg_one_of_correctedSubsetSum_eq
    g hg x z hxB hzB hxz k A C hAC hsum, ?_⟩
  intro hreverse
  have hCA : C ≠ A := Ne.symm hAC
  have hsumReverse :
      (∑ b ∈ C, correctedOwnerValue g x z k b) =
        ∑ b ∈ A, correctedOwnerValue g x z k b := hsum.symm
  apply not_both_retained_gaps_ge_neg_one_of_correctedSubsetSum_eq
    g hg x z hxB hzB hxz k C A hCA hsumReverse
  omega

/-- Integer form of the two-sided obstruction: one retained coefficient gap
is at most `-2`, and the other is at least `2`. -/
theorem correctedSubsetSum_eq_forces_opposite_retained_gaps
    (g : Fin n → G) (hg : ValidTuple g)
    (x z : Fin n) {B : Finset (Fin n)}
    (hxB : x ∉ B) (hzB : z ∉ B) (hxz : x ≠ z)
    (k : ↥B → ℤ) (A C : Finset ↥B) (hAC : A ≠ C)
    (hsum : (∑ b ∈ A, correctedOwnerValue g x z k b) =
      ∑ b ∈ C, correctedOwnerValue g x z k b) :
    (correctedSubsetXCoefficient k A -
          correctedSubsetXCoefficient k C ≤ -2 ∧
        2 ≤ correctedSubsetZCoefficient k A -
          correctedSubsetZCoefficient k C) ∨
      (correctedSubsetZCoefficient k A -
            correctedSubsetZCoefficient k C ≤ -2 ∧
        2 ≤ correctedSubsetXCoefficient k A -
          correctedSubsetXCoefficient k C) := by
  have hcross := correctedSubsetSum_eq_forces_crossing_retained_gaps
    g hg x z hxB hzB hxz k A C hAC hsum
  omega

/-- State-level terminal interface after primitive exchange.  It retains a
primitive pair, a correction parameter in one three-point window, a
kernel-valued corrected row for every deleted owner, and the exact crossing
law for all corrected-subset collisions. -/
def PrimitiveThreeResidueCorrectedRows
    {q : ℕ} (g : Fin n → ZMod (2 ^ 6 * q))
    (y : ZMod (2 ^ 6 * q)) (B : Finset (Fin n)) : Prop :=
  ∃ x z : Fin n, ∃ k : ↥B → ℤ,
    x ∉ B ∧ z ∉ B ∧ x ≠ z ∧
      addOrderOf
        ((QuotientAddGroup.mk' (AddSubgroup.zmultiples y)) (g x - g z)) =
          64 ∧
      (∀ b : ↥B, k b ∈ ({-2, -1, 0, 1} : Finset ℤ)) ∧
      ((∀ b : ↥B, k b ≠ -2) ∨ ∀ b : ↥B, k b ≠ 1) ∧
      (∀ b : ↥B,
        correctedOwnerValue g x z k b ∈ AddSubgroup.zmultiples y) ∧
      ∀ A C : Finset ↥B, A ≠ C →
        (∑ b ∈ A, correctedOwnerValue g x z k b) =
          ∑ b ∈ C, correctedOwnerValue g x z k b →
        (correctedSubsetXCoefficient k A -
              correctedSubsetXCoefficient k C ≤ -2 ∧
            2 ≤ correctedSubsetZCoefficient k A -
              correctedSubsetZCoefficient k C) ∨
          (correctedSubsetZCoefficient k A -
                correctedSubsetZCoefficient k C ≤ -2 ∧
            2 ≤ correctedSubsetXCoefficient k A -
              correctedSubsetXCoefficient k C)

/-- Repackage a primitive unit window as the exact corrected-row collision
terminal. -/
theorem PrimitiveTwoRetainedSixthStratumUnitWindow.toCorrectedRows
    {q : ℕ} [NeZero (2 ^ 6 * q)]
    (g : Fin n → ZMod (2 ^ 6 * q)) (hg : ValidTuple g)
    (y : ZMod (2 ^ 6 * q)) (B : Finset (Fin n))
    (hwindow : PrimitiveTwoRetainedSixthStratumUnitWindow g y B) :
    PrimitiveThreeResidueCorrectedRows g y B := by
  classical
  rcases hwindow with ⟨p, hprimitive, hunit, houter⟩
  let k : ↥B → ℤ := fun b ↦ Classical.choose (hunit b).2
  have hkSpec : ∀ b : ↥B,
      k b ∈ ({-2, -1, 0, 1} : Finset ℤ) ∧
        p.weight b = 2 * k b ∧
        correctedOwnerValue g p.x p.z k b ∈
          AddSubgroup.zmultiples y := by
    intro b
    have hs := Classical.choose_spec (hunit b).2
    refine ⟨hs.1, hs.2.1, ?_⟩
    simpa only [k, correctedOwnerValue] using hs.2.2.1
  have hkWindow :
      (∀ b : ↥B, k b ≠ -2) ∨ ∀ b : ↥B, k b ≠ 1 := by
    rcases houter with hnoLeft | hnoRight
    · left
      intro b hkb
      have hweight := (hkSpec b).2.1
      exact hnoLeft b (by rw [hkb] at hweight; omega)
    · right
      intro b hkb
      have hweight := (hkSpec b).2.1
      exact hnoRight b (by rw [hkb] at hweight; omega)
  refine ⟨p.x, p.z, k, p.x_not_mem, p.z_not_mem, p.x_ne_z,
    hprimitive, (fun b ↦ (hkSpec b).1), hkWindow,
    (fun b ↦ (hkSpec b).2.2), ?_⟩
  intro A C hAC hsum
  exact correctedSubsetSum_eq_forces_opposite_retained_gaps
    g hg p.x p.z p.x_not_mem p.z_not_mem p.x_ne_z k A C hAC hsum

end MinModulus
