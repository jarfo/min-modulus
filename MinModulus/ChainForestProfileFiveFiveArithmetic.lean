/-- Every compatible equal-five phase has a kernel-checked signed
basis certificate, including both sides of integral binary boundaries. -/
theorem exists_five_five_basis_certificate
    {e r q : ℕ} (he : 1 ≤ e ∧ e ≤ 5)
    (hr : r < 2^(5-e)*31) (hq : q < 31) (hlink : 31 ∣ 2*r+q) :
    ∃ p, FiveFiveBasisCertificate e r q p := by
  have hqeq := bounded_primitive_phase_eq_of_link (by decide : 0 < 31) hq hlink
  subst q
  rcases he with ⟨helo,hehi⟩
  interval_cases e
  · exact ⟨_,fiveFiveBasis1_checked ⟨r,by simpa using hr⟩⟩
  · exact ⟨_,fiveFiveBasis2_checked ⟨r,by simpa using hr⟩⟩
  · exact ⟨_,fiveFiveBasis3_checked ⟨r,by simpa using hr⟩⟩
  · exact ⟨_,fiveFiveBasis4_checked ⟨r,by simpa using hr⟩⟩
  · exact ⟨_,fiveFiveBasis5_checked ⟨r,by simpa using hr⟩⟩

/-- The complete equal-five certificates produce an actual affordable
full-length rival at every n >= 67, with no extra dyadic hypotheses. -/
theorem exists_five_five_primitive_rival
    {e n N L M E H c V α z r q : ℕ}
    (he : 1 ≤ e ∧ e ≤ 5) (hn : 67 ≤ n) (hL : L+10=n)
    (hr : r < 2^(5-e)*31) (hq : q < 31) (hlink : 31 ∣ 2*r+q)
    (hH : 1 ≤ H) (hc : 0 < c) (hnc : H+c ≤ n) (hbase : H+c=V+1)
    (hM : M+E=32*2^(5-e)*2^L) (hE : E ≤ 8*2^(5-e)*H)
    (hap : (2^(5-e)*31 : ℕ)*(α : ℤ)=15*((2 : ℤ)^L-H)+16*c+(r : ℤ)*M)
    (hzp : 31*(z : ℤ)=(2 : ℤ)^L+30*H+30*c-31+(q : ℤ)*M)
    (x a b : ZMod N) (hα : α • x=2^e • a)
    (hz : z • x+a+b=V • x) (hmx : M • x=0) :
    ∃ s ta tb, n ≤ s ∧ (ta ≠ 31 ∨ tb ≠ 31) ∧ ∃ u,
      val L u=s ∧ dsum L u+gmin 4 ta+gmin 4 tb ≤ n ∧
      s • x+ta • a+tb • b=V • x := by
  obtain ⟨p,hp⟩ := exists_five_five_basis_certificate he hr hq hlink
  rcases hp with hp | hp | hp
  · obtain ⟨s,hs,hne,u,hu,hcost,heval⟩ := exists_rival_of_primitive_basis_nonintegral_certificate
      (fiveFivePrimitiveBasisGeometry e) p (P:=15) (Q:=1) (r:=(r : ℤ)) (q:=(q : ℤ)) hn (by simpa [fiveFivePrimitiveBasisGeometry,add_assoc] using hL)
      hH hnc hbase hM hE hap (by simpa [fiveFivePrimitiveBasisGeometry] using hzp) x a b hα hz hmx hp
    exact ⟨s,p.ta,p.tb,hs,hne,u,hu,hcost,heval⟩
  · obtain ⟨s,hs,hne,u,hu,hcost,heval⟩ := exists_rival_of_primitive_basis_integral_certificate
      (fiveFivePrimitiveBasisGeometry e) p (P:=15) (Q:=1) (r:=(r : ℤ)) (q:=(q : ℤ)) hn (by simpa [fiveFivePrimitiveBasisGeometry,add_assoc] using hL)
      hH hc hnc hbase hM hE hap (by simpa [fiveFivePrimitiveBasisGeometry] using hzp) x a b hα hz hmx hp
    exact ⟨s,p.ta,p.tb,hs,hne,u,hu,hcost,heval⟩
  · obtain ⟨s,hs,hne,u,hu,hcost,heval⟩ := exists_rival_of_primitive_basis_below_integral_certificate
      (fiveFivePrimitiveBasisGeometry e) p (P:=15) (Q:=1) (r:=(r : ℤ)) (q:=(q : ℤ)) hn (by simpa [fiveFivePrimitiveBasisGeometry,add_assoc] using hL)
      hH hnc hbase hM hE hap (by simpa [fiveFivePrimitiveBasisGeometry] using hzp) x a b hα hz hmx hp
    exact ⟨s,p.ta,p.tb,hs,hne,u,hu,hcost,heval⟩

end MinModulus
