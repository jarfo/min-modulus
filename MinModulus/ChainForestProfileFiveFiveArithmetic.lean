import MinModulus.ChainForestProfileEqualBasisCertificates

/-! Complete primitive-basis arithmetic for two length-five companions.
All 961 phases are kernel-checked, including 31 positive integral
certificates and 33 certificates just below an integral boundary. Every
phase has an affordable actual group rival for all n >= 67. The genuine
forest consumer is separate; the unrestricted conjecture remains open. -/

namespace MinModulus

def fiveFivePrimitiveBasisGeometry (e : ℕ) : PrimitiveBasisGeometry :=
  ⟨5,5,2^e,2^(5-e),31,32*2^(5-e),8*2^(5-e),16,1⟩

def FiveFiveBasisCertificate (e : ℕ) (r q : ℤ) (p : PrimitiveBasisRivalPlan) : Prop :=
  PrimitiveBasisNonintegralCertificate (fiveFivePrimitiveBasisGeometry e) 32 400000 67 15 1 r q p ∨
  PrimitiveBasisIntegralCertificate (fiveFivePrimitiveBasisGeometry e) 40 2000 67 15 1 r q p ∨
  PrimitiveBasisBelowIntegralCertificate (fiveFivePrimitiveBasisGeometry e) 2000 67 15 1 r q p

instance (e : ℕ) (r q : ℤ) (p : PrimitiveBasisRivalPlan) :
    Decidable (FiveFiveBasisCertificate e r q p) := by
  unfold FiveFiveBasisCertificate
  infer_instance

